# Auto detect text files and perform LF normalization
* text=auto

# Integrity-checked inputs must keep the same bytes in Windows checkouts.
toolchain/patches/dart/*.patch text eol=lf whitespace=-blank-at-eol
toolchain/patches/icu/*.patch text eol=lf whitespace=-blank-at-eol
toolchain/*.specs text eol=lf

# Preserve upstream distribution notices byte for byte.
release/licenses/*.LICENSE -text whitespace=-blank-at-eol

# Recovery donors must match the original producer checksums on every host.
