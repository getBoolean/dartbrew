diff --git a/runtime/vm/ctr_double_helpers.cc b/runtime/vm/ctr_double_helpers.cc
index 3abdbecb..54421c77 100755
--- a/runtime/vm/ctr_double_helpers.cc
+++ b/runtime/vm/ctr_double_helpers.cc
@@ -71,3 +71,57 @@ extern "C" void CtrFloatConvert(uint32_t* words, intptr_t narrow) {
     __builtin_memcpy(words, &result, sizeof(result));
   }
 }
+
+extern "C" double CtrDoubleSqrt(double value) {
+  uint64_t bits;
+  __builtin_memcpy(&bits, &value, sizeof(bits));
+  const uint64_t sign = UINT64_C(0x8000000000000000);
+  const uint64_t fraction_mask = UINT64_C(0x000fffffffffffff);
+  const uint64_t infinity = UINT64_C(0x7ff0000000000000);
+  const uint64_t magnitude = bits & ~sign;
+  uint64_t result;
+  if (magnitude == 0 || bits == infinity) {
+    result = bits;
+  } else if (magnitude > infinity) {
+    result = bits | UINT64_C(0x0008000000000000);  // Quiet a NaN.
+  } else if ((bits & sign) != 0) {
+    result = UINT64_C(0x7ff8000000000000);
+  } else {
+    int exponent = static_cast<int>(bits >> 52) - 1023;
+    uint64_t mantissa = bits & fraction_mask;
+    if (bits < (UINT64_C(1) << 52)) {
+      exponent = -1022;
+      while (mantissa < (UINT64_C(1) << 52)) {
+        mantissa <<= 1;
+        --exponent;
+      }
+    } else {
+      mantissa |= UINT64_C(1) << 52;
+    }
+    if (exponent % 2 != 0) {
+      mantissa <<= 1;
+      --exponent;
+    }
+    // Restore sqrt(mantissa << 52), two radicand bits per step. The
+    // 106-bit radicand need not be materialized; the remainder fits 55 bits.
+    uint64_t root = 0, remainder = 0;
+    for (int pair = 52; pair >= 0; --pair) {
+      const int shift = pair * 2;
+      const uint64_t digit = shift >= 52 ? (mantissa >> (shift - 52)) & 3 : 0;
+      remainder = (remainder << 2) | digit;
+      root <<= 1;
+      const uint64_t trial = (root << 1) | 1;
+      if (remainder >= trial) {
+        remainder -= trial;
+        ++root;
+      }
+    }
+    // sqrt(N) exceeds root + 1/2 iff N-root^2 > root. An integer N
+    // cannot equal the midpoint square root^2 + root + 1/4.
+    root += remainder > root;
+    result = (static_cast<uint64_t>(exponent / 2 + 1023) << 52) |
+             (root & fraction_mask);
+  }
+  __builtin_memcpy(&value, &result, sizeof(value));
+  return value;
+}
