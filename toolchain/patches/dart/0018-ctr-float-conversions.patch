+extern "C" void CtrFloatConvert(uint32_t* words, intptr_t narrow) {
+  if (narrow) {
+    double value;
+    __builtin_memcpy(&value, words, sizeof(value));
+#if defined(__3DS__)
+    const float result = __aeabi_d2f(value);
+#else
+    const float result = static_cast<float>(value);
+#endif
+    __builtin_memcpy(words, &result, sizeof(result));
+  } else {
+    float value;
+    __builtin_memcpy(&value, words, sizeof(value));
+#if defined(__3DS__)
+    const double result = __aeabi_f2d(value);
+#else
+    const double result = static_cast<double>(value);
+#endif
+    __builtin_memcpy(words, &result, sizeof(result));
+  }
+}
