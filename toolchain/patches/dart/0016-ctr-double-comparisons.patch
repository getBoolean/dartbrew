+
+extern "C" int CtrDoubleCompare(double left, double right) {
+  uint64_t lhs, rhs;
+  __builtin_memcpy(&lhs, &left, sizeof(lhs));
+  __builtin_memcpy(&rhs, &right, sizeof(rhs));
+  const uint64_t sign = UINT64_C(0x8000000000000000);
+  const uint64_t magnitude = ~sign;
+  const uint64_t infinity = UINT64_C(0x7ff0000000000000);
+  if ((lhs & magnitude) > infinity || (rhs & magnitude) > infinity) return 2;
+  if (lhs == rhs || ((lhs | rhs) & magnitude) == 0) return 0;
+  if ((lhs ^ rhs) & sign) return (lhs & sign) ? -1 : 1;
+  const bool less = (lhs & sign) ? lhs > rhs : lhs < rhs;
+  return less ? -1 : 1;
+}
