+#if defined(DART_HOST_OS_CTR)
+  Exceptions::ThrowUnsupportedError(
+      "Dynamic library executable lookup is not supported on CTR.");
+#else
   return DynamicLibrary::New(LoadDynamicLibrary(nullptr), &DlsymDynamicLibrary,
                              &Utils::UnloadDynamicLibrary);
+#endif
 }
 
 DEFINE_NATIVE_ENTRY(Ffi_dl_close, 0, 1) {
@@ -617,7 +625,10 @@ intptr_t FfiResolveInternal(const String& asset,
   }
 
   // Resolution in current process.
-#if !defined(DART_HOST_OS_WINDOWS)
+#if defined(DART_HOST_OS_CTR)
+  void* const result = Utils::ResolveSymbolInDynamicLibrary(
+      nullptr, symbol.ToCString(), error);
+#elif !defined(DART_HOST_OS_WINDOWS)
   void* const result = Utils::ResolveSymbolInDynamicLibrary(
       RTLD_DEFAULT, symbol.ToCString(), error);
 #else
