Resolve statically linked native libraries on CTR.

diff --git a/runtime/lib/ffi_dynamic_library.cc b/runtime/lib/ffi_dynamic_library.cc
index 24687449..c7510111 100644
--- a/runtime/lib/ffi_dynamic_library.cc
+++ b/runtime/lib/ffi_dynamic_library.cc
@@ -213,7 +213,10 @@ DEFINE_NATIVE_ENTRY(Ffi_dl_open, 0, 1) {
 }
 
 DEFINE_NATIVE_ENTRY(Ffi_dl_processLibrary, 0, 0) {
-#if defined(DART_HOST_OS_LINUX) || defined(DART_HOST_OS_MACOS) ||              \
+#if defined(DART_HOST_OS_CTR)
+  Exceptions::ThrowUnsupportedError(
+      "Dynamic library process lookup is not supported on CTR.");
+#elif defined(DART_HOST_OS_LINUX) || defined(DART_HOST_OS_MACOS) ||              \
     defined(DART_HOST_OS_ANDROID) || defined(DART_HOST_OS_FUCHSIA)
   return DynamicLibrary::New(RTLD_DEFAULT, &DlsymDynamicLibrary,
                              &Utils::UnloadDynamicLibrary);
@@ -225,8 +228,13 @@ DEFINE_NATIVE_ENTRY(Ffi_dl_processLibrary, 0, 0) {
 }
 
