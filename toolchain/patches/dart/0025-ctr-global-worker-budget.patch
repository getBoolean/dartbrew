diff --git a/runtime/vm/thread_pool.h b/runtime/vm/thread_pool.h
index 31c1a66b..cba101fe 100644
--- a/runtime/vm/thread_pool.h
+++ b/runtime/vm/thread_pool.h
@@ -36,6 +36,9 @@ class ThreadPool {
     DISALLOW_COPY_AND_ASSIGN(Task);
   };
 
+  // CTR shares a small process thread allowance with libctru and mutators.
+  // Keep ordinary VM work queued; blocking compensation remains supported.
+  static constexpr uintptr_t kCtrGlobalWorkerLimit = 4;
   explicit ThreadPool(uintptr_t max_pool_size = 0);
 
   // Prevent scheduling of new tasks, wait until all pending tasks are done
diff --git a/runtime/vm/thread_pool_test.cc b/runtime/vm/thread_pool_test.cc
index 4798d57d..e5ebd5bb 100644
--- a/runtime/vm/thread_pool_test.cc
+++ b/runtime/vm/thread_pool_test.cc
@@ -257,4 +257,104 @@ THREAD_POOL_UNIT_TEST_CASE(ThreadPool_RecursiveSpawn) {
   EXPECT_EQ(kTotalTasks, done);
 }
 
+class CtrBudgetTask : public ThreadPool::Task {
+ public:
+  CtrBudgetTask(Monitor* gate, bool* release, int* started, int* completed)
+      : gate_(gate), release_(release), started_(started), completed_(completed) {}
+  void Run() override {
+    MonitorLocker lock(gate_);
+    ++*started_;
+    lock.NotifyAll();
+    while (!*release_) lock.Wait();
+    ++*completed_;
+    lock.NotifyAll();
+  }
+ private:
+  Monitor* gate_;
+  bool* release_;
+  int* started_;
+  int* completed_;
+};
+
+THREAD_POOL_UNIT_TEST_CASE(ThreadPool_CTRBudgetQueuesAndDrains) {
+  Monitor gate;
+  bool release = false;
+  int started = 0;
+  int completed = 0;
+  ThreadPool pool(ThreadPool::kCtrGlobalWorkerLimit);
+  constexpr int kTasks = 64;
+  for (int i = 0; i < kTasks; ++i) {
+    EXPECT(pool.Run<CtrBudgetTask>(&gate, &release, &started, &completed));
+  }
+  {
+    MonitorLocker lock(&gate);
+    while (started < 4) lock.Wait();
+    // Pending work must remain queued instead of creating 64 native stacks.
+    EXPECT_EQ(4U, pool.workers_started());
+    release = true;
+    lock.NotifyAll();
+    while (completed != kTasks) lock.Wait();
+  }
+  EXPECT_EQ(kTasks, completed);
+}
+
+class CtrBlockedTask : public ThreadPool::Task {
+ public:
+  CtrBlockedTask(ThreadPool* pool, Monitor* gate, bool* blocked,
+                 bool* release, bool* completed)
+      : pool_(pool), gate_(gate), blocked_(blocked), release_(release),
+        completed_(completed) {}
+  void Run() override {
+    pool_->MarkCurrentWorkerAsBlocked();
+    {
+      MonitorLocker lock(gate_);
+      *blocked_ = true;
+      lock.NotifyAll();
+      while (!*release_) lock.Wait();
+    }
+    pool_->MarkCurrentWorkerAsUnBlocked();
+    MonitorLocker lock(gate_);
+    *completed_ = true;
+    lock.NotifyAll();
+  }
+ private:
+  ThreadPool* pool_;
+  Monitor* gate_;
+  bool* blocked_;
+  bool* release_;
+  bool* completed_;
+};
+
+class CtrReleaseTask : public ThreadPool::Task {
+ public:
+  CtrReleaseTask(Monitor* gate, bool* release) : gate_(gate), release_(release) {}
+  void Run() override {
+    MonitorLocker lock(gate_);
+    *release_ = true;
+    lock.NotifyAll();
+  }
+ private:
+  Monitor* gate_;
+  bool* release_;
+};
+
+THREAD_POOL_UNIT_TEST_CASE(ThreadPool_CTRBudgetAllowsBlockedProgress) {
+  Monitor gate;
+  bool blocked = false;
+  bool release = false;
+  bool completed = false;
+  ThreadPool pool(1);
+  EXPECT(pool.Run<CtrBlockedTask>(&pool, &gate, &blocked, &release, &completed));
+  {
+    MonitorLocker lock(&gate);
+    while (!blocked) lock.Wait();
+  }
+  EXPECT(pool.Run<CtrReleaseTask>(&gate, &release));
+  {
+    MonitorLocker lock(&gate);
+    while (!completed) lock.Wait();
+  }
+  EXPECT_EQ(2U, pool.workers_started());
+}
+
