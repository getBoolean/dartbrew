--- /dev/null
+++ b/runtime/vm/ctr_double_helpers.cc
@@ -0,0 +1,34 @@
+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "vm/ctr_double_helpers.h"
+
+#if defined(__3DS__)
+// GCC's ARM runtime helpers use the base AAPCS even in a hard-float binary.
+// Without pcs("aapcs") a declaration silently passes operands in D0/D1 while
+// the provider reads R0-R3. Keep the bridge in a separate translation unit.
+extern "C" {
+double __aeabi_dadd(double, double) __attribute__((pcs("aapcs")));
+double __aeabi_dsub(double, double) __attribute__((pcs("aapcs")));
+double __aeabi_dmul(double, double) __attribute__((pcs("aapcs")));
+double __aeabi_ddiv(double, double) __attribute__((pcs("aapcs")));
+}
+
+extern "C" double CtrDoubleAdd(double left, double right) {
+  return __aeabi_dadd(left, right);
+}
+extern "C" double CtrDoubleSub(double left, double right) {
+  return __aeabi_dsub(left, right);
+}
+extern "C" double CtrDoubleMul(double left, double right) {
+  return __aeabi_dmul(left, right);
+}
+extern "C" double CtrDoubleDiv(double left, double right) {
+  return __aeabi_ddiv(left, right);
+}
+#else
+// Host precompiler/simulator implementation, never linked into CTR binaries.
+extern "C" double CtrDoubleAdd(double left, double right) { return left + right; }
+extern "C" double CtrDoubleSub(double left, double right) { return left - right; }
+extern "C" double CtrDoubleMul(double left, double right) { return left * right; }
+extern "C" double CtrDoubleDiv(double left, double right) { return left / right; }
+#endif
