new file mode 100644
index 00000000..01224d57
--- /dev/null
+++ b/runtime/vm/ctr_double_helpers_test.cc
@@ -0,0 +1,77 @@
+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+// Standalone helper/ABI test; numeric_cases.h is produced by the host driver.
+#include <stdint.h>
+#if !defined(CTR_DOUBLE_FREESTANDING)
+#include <stdio.h>
+#endif
+#if !defined(CTR_DOUBLE_BASELINE)
+#include "vm/ctr_double_helpers.h"
+#else
+static double CtrDoubleAdd(double a, double b) { return a + b; }
+static double CtrDoubleSub(double a, double b) { return a - b; }
+static double CtrDoubleMul(double a, double b) { return a * b; }
+static double CtrDoubleDiv(double a, double b) { return a / b; }
+#endif
+#include "numeric_cases.h"
+
+static double FromBits(uint64_t bits) {
+  double value;
+  __builtin_memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+static uint64_t Bits(double value) {
+  uint64_t bits;
+  __builtin_memcpy(&bits, &value, sizeof(bits));
+  return bits;
+}
+static bool IsNaN(uint64_t value) {
+  return (value & UINT64_C(0x7fffffffffffffff)) > UINT64_C(0x7ff0000000000000);
+}
+
+// Volatile indirect calls keep operands dynamic and cross the actual ABI.
+static double (*volatile operations[])(double, double) = {
+    CtrDoubleAdd, CtrDoubleSub, CtrDoubleMul, CtrDoubleDiv};
+
+#if defined(CTR_DOUBLE_FREESTANDING)
+extern "C" void test_write(const char* data, unsigned length);
+extern "C" int test_abi(double (*operation)(double, double));
+#endif
+static void Mismatch(unsigned index, uint64_t actual, uint64_t expected) {
+  const uint64_t values[] = {index, actual, expected};
+  char message[] = "numeric mismatch: case=0000000000000000 actual=0000000000000000 expected=0000000000000000\n";
+  const unsigned offsets[] = {23, 47, 73};
+  for (unsigned i = 0; i < 3; i++) {
+    for (unsigned n = 0; n < 16; n++) {
+      message[offsets[i] + n] = "0123456789abcdef"[(values[i] >> (60 - 4 * n)) & 15];
+    }
+  }
+#if defined(CTR_DOUBLE_FREESTANDING)
+  test_write(message, sizeof(message) - 1);
+#else
+  fputs(message, stderr);
+#endif
+}
+
+int main() {
+#if defined(CTR_DOUBLE_FREESTANDING)
+  uint32_t fpscr;
+  asm volatile("vmrs %0, fpscr" : "=r"(fpscr));
+  if ((fpscr & 0x03000000) != 0x03000000) return 2;
+#endif
+  for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+    const NumericCase& input = cases[i];
+    const uint64_t actual = Bits(operations[input.op](FromBits(input.a), FromBits(input.b)));
+    if (actual != input.expected && !(IsNaN(actual) && IsNaN(input.expected))) {
+      Mismatch(i, actual, input.expected);
+      return 1;
+    }
+  }
+#if defined(CTR_DOUBLE_FREESTANDING)
+  // D8-D15 and R4-R11 must survive the provider and hard-float bridge.
+  if (test_abi(CtrDoubleDiv) != 0) return 3;
+  asm volatile("vmrs %0, fpscr" : "=r"(fpscr));
+  if ((fpscr & 0x03000000) != 0x03000000) return 4;
+#endif
+  return 0;
+}
