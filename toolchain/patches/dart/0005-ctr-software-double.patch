+#ifndef RUNTIME_VM_CTR_DOUBLE_HELPERS_H_
+#define RUNTIME_VM_CTR_DOUBLE_HELPERS_H_
+
+// Hard-float entry points. The CTR definitions bridge to the integer-register
+// software provider; no numeric instruction may consume these operands.
+extern "C" double CtrDoubleAdd(double left, double right);
+extern "C" double CtrDoubleSub(double left, double right);
+extern "C" double CtrDoubleMul(double left, double right);
+extern "C" double CtrDoubleDiv(double left, double right);
