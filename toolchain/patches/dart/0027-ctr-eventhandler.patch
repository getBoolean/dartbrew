+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_CTR) || defined(DART_CTR_POLL_HOST_TEST)
+
+#include "bin/eventhandler_ctr_poll.h"
+
+#include <errno.h>       // NOLINT
+#include <limits.h>      // NOLINT
+#include <poll.h>        // NOLINT
+#include <stdlib.h>      // NOLINT
+
+#if !defined(__3DS__)
+#include <chrono>
+#endif
+
+namespace dart {
+namespace bin {
+
+namespace {
+
+// Grows |*items| to hold at least |count| elements. Allocation failure is
+// fatal, as for the VM's own allocations.
+template <typename T>
+void Reserve(T** items, intptr_t* capacity, intptr_t count) {
+  if (count <= *capacity) return;
+  intptr_t grown = *capacity == 0 ? 8 : *capacity * 2;
+  while (grown < count) grown *= 2;
+  T* resized = static_cast<T*>(realloc(*items, grown * sizeof(T)));
+  if (resized == nullptr) abort();
+  *items = resized;
+  *capacity = grown;
+}
+
+constexpr int kInterest = POLLIN | POLLOUT;
+constexpr int kTerminal = POLLHUP | POLLERR | POLLNVAL;
+
+}  // namespace
+
+CtrPollSet::CtrPollSet(Clock clock) : clock_(clock) {
+#if defined(__3DS__)
+  LightLock_Init(&lock_);
+  CondVar_Init(&changed_);
+#endif
+}
+
+CtrPollSet::~CtrPollSet() {
+  free(entries_);
+  free(queued_);
+  free(fds_);
+  free(timers_);
+  free(ready_);
+  free(delivered_);
+  free(due_);
+}
+
+void CtrPollSet::Lock() {
+#if defined(__3DS__)
+  LightLock_Lock(&lock_);
+#else
+  lock_.lock();
+#endif
+}
+
+void CtrPollSet::Unlock() {
+#if defined(__3DS__)
+  LightLock_Unlock(&lock_);
+#else
+  lock_.unlock();
+#endif
+}
+
+// Called with lock_ held.
+void CtrPollSet::Signal() {
+#if defined(__3DS__)
+  CondVar_Signal(&changed_);
+#else
+  changed_.notify_one();
+#endif
+}
+
+// Called with lock_ held; releases it while waiting. |timeout| < 0 waits
+// until signalled.
+void CtrPollSet::Sleep(int timeout) {
+#if defined(__3DS__)
+  if (timeout < 0) {
+    CondVar_Wait(&changed_, &lock_);
+  } else {
+    CondVar_WaitTimeout(&changed_, &lock_, static_cast<s64>(timeout) * 1000000);
+  }
+#else
+  std::unique_lock<std::mutex> lock(lock_, std::adopt_lock);
+  if (timeout < 0) {
+    changed_.wait(lock);
+  } else {
+    changed_.wait_for(lock, std::chrono::milliseconds(timeout));
+  }
+  lock.release();
+#endif
+}
+
+void CtrPollSet::Send(intptr_t id, int64_t dart_port, int64_t data) {
+  Lock();
+  Reserve(&queued_, &queued_capacity_, queued_count_ + 1);
+  queued_[queued_count_++] = {id, dart_port, data};
+  Signal();
+  Unlock();
+}
+
+CtrPollSet::Entry* CtrPollSet::Find(intptr_t fd) {
+  for (intptr_t i = 0; i < entry_count_; i++) {
+    if (entries_[i].fd == fd) return &entries_[i];
+  }
+  return nullptr;
+}
+
+void CtrPollSet::Rearm(intptr_t fd, int events) {
+  Lock();
+  Entry* entry = Find(fd);
+  if (entry != nullptr && (entry->suppressed & events) != 0) {
+    entry->suppressed &= ~events;
+    dirty_ = true;
+    Signal();
+  }
+  Unlock();
+}
+
+void CtrPollSet::Update(intptr_t fd, int events, bool edge_triggered) {
+  events &= kInterest;
+  Lock();
+  Entry* entry = Find(fd);
+  if (events == 0) {
+    if (entry != nullptr) {
+      *entry = entries_[--entry_count_];
+      dirty_ = true;
+    }
+  } else if (entry == nullptr || entry->events != events ||
+             entry->edge_triggered != edge_triggered) {
+    if (entry == nullptr) {
+      Reserve(&entries_, &entry_capacity_, entry_count_ + 1);
+      entry = &entries_[entry_count_++];
+    }
+    *entry = {fd, events, 0, edge_triggered, false};
+    dirty_ = true;
+  }
+  Unlock();
+}
+
+void CtrPollSet::SetTimer(int64_t dart_port, int64_t deadline) {
+  for (intptr_t i = 0; i < timer_count_; i++) {
+    if (timers_[i].dart_port == dart_port) {
+      if (deadline < 0) {
+        timers_[i] = timers_[--timer_count_];
+      } else {
+        timers_[i].deadline = deadline;
+      }
+      return;
+    }
+  }
+  if (deadline < 0) return;
+  Reserve(&timers_, &timer_capacity_, timer_count_ + 1);
+  timers_[timer_count_++] = {dart_port, deadline};
+}
+
+void CtrPollSet::Add(intptr_t fd, int events) {
+  // Field by field: pollfd's field types differ between libctru and POSIX.
+  pollfd& item = fds_[fd_count_++];
+  item.fd = static_cast<int>(fd);
+  item.events = events;
+  item.revents = 0;
+}
+
+// Called with lock_ held.
+void CtrPollSet::Rebuild() {
+  Reserve(&fds_, &fd_capacity_, entry_count_);
+  fd_count_ = 0;
+  for (intptr_t i = 0; i < entry_count_; i++) {
+    const Entry& entry = entries_[i];
+    const int events = entry.events & ~entry.suppressed;
+    if (entry.closed || events == 0) continue;
+    Add(entry.fd, events);
+  }
+  dirty_ = false;
+}
+
+int CtrPollSet::Timeout() {
+  if (timer_count_ == 0) return -1;
+  int64_t deadline = timers_[0].deadline;
+  for (intptr_t i = 1; i < timer_count_; i++) {
+    if (timers_[i].deadline < deadline) deadline = timers_[i].deadline;
+  }
+  const int64_t remaining = deadline - clock_();
+  if (remaining <= 0) return 0;
+  return remaining > INT_MAX ? INT_MAX : static_cast<int>(remaining);
+}
+
+// Called with lock_ held after poll() returned |polled| ready descriptors.
+void CtrPollSet::Collect(intptr_t polled) {
+  for (intptr_t i = 0; polled > 0 && i < fd_count_; i++) {
+    const int revents = fds_[i].revents;
+    if (revents == 0) continue;
+    Entry* entry = Find(fds_[i].fd);
+    if (entry == nullptr) continue;
+    const int reported = revents & (entry->events | kTerminal);
+    if (reported == 0) continue;
+    if (entry->edge_triggered) entry->suppressed |= reported & kInterest;
+    // Listening sockets are level-triggered, but a terminal condition never
+    // clears either.
+    if ((reported & kTerminal) != 0) entry->closed = true;
+    dirty_ = true;
+    Reserve(&ready_, &ready_capacity_, ready_count_ + 1);
+    ready_[ready_count_++] = {entry->fd, reported};
+  }
+}
+
+// Called with lock_ held.
+void CtrPollSet::TakeMessages() {
+  Message* swap = delivered_;
+  const intptr_t swap_capacity = delivered_capacity_;
+  delivered_ = queued_;
+  delivered_capacity_ = queued_capacity_;
+  delivered_count_ = queued_count_;
+  queued_ = swap;
+  queued_capacity_ = swap_capacity;
+  queued_count_ = 0;
+}
+
+bool CtrPollSet::Wait() {
+  // A wake-up that only re-armed a descriptor rebuilds the set and waits
+  // again, so every return has something to report.
+  do {
+    ready_count_ = 0;
+    Lock();
+    if (dirty_) Rebuild();
+    int timeout = Timeout();
+    if (fd_count_ == 0) {
+      // Nothing to poll: Send and Rearm signal under the same lock, so no
+      // wake-up is lost between the checks and the wait.
+      if (queued_count_ == 0 && timeout != 0) Sleep(timeout);
+      TakeMessages();
+      Unlock();
+    } else {
+      if (queued_count_ != 0) {
+        timeout = 0;
+      } else if (timeout < 0 || timeout > kPollSliceMillis) {
+        timeout = kPollSliceMillis;
+      }
+      Unlock();
+      int polled;
+      do {
+        polled = poll(fds_, fd_count_, timeout);
+      } while (polled < 0 && errno == EINTR);
+      if (polled < 0) return false;
+      Lock();
+      Collect(polled);
+      TakeMessages();
+      Unlock();
+    }
+    due_count_ = 0;
+    const int64_t now = clock_();
+    for (intptr_t i = 0; i < timer_count_;) {
+      if (timers_[i].deadline <= now) {
+        Reserve(&due_, &due_capacity_, due_count_ + 1);
+        due_[due_count_++] = timers_[i].dart_port;
+        timers_[i] = timers_[--timer_count_];
+      } else {
+        i++;
+      }
+    }
+  } while (ready_count_ == 0 && delivered_count_ == 0 && due_count_ == 0);
+  return true;
+}
+
+}  // namespace bin
+}  // namespace dart
+
+#endif  // defined(DART_HOST_OS_CTR) || defined(DART_CTR_POLL_HOST_TEST)
