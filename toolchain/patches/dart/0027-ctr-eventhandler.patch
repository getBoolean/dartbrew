+intptr_t DescriptorInfo::GetPollEvents() {
+  // poll() reports POLLERR, POLLHUP and POLLNVAL without asking.
+  intptr_t events = 0;
+  if ((Mask() & (1 << kInEvent)) != 0) {
+    events |= POLLIN;
+  }
+  if ((Mask() & (1 << kOutEvent)) != 0) {
+    events |= POLLOUT;
+  }
+  return events;
+}
