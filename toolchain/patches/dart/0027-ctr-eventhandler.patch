+// The descriptor set, wake-up and timer state behind the CTR event handler.
+// It has no Dart API dependency, so the same code also builds on POSIX hosts
+// for runtime/ctr/test/eventhandler_host_test.cc.
+//
+// libctru's soc service has no epoll, eventfd or pipes, so:
+// - Descriptors are multiplexed with poll(). The pollfd array is rebuilt only
+//   when the set changes.
+// - Other threads queue messages under a lock and signal a condition
+//   variable. soc's poll() can sit out its whole timeout even when a socket
+//   is ready (libctru issue #412), so a loopback wake-up socket cannot cut a
+//   long poll short. With descriptors registered, each poll() is therefore
+//   bounded by kPollSliceMillis and the queue is checked between slices. With
+//   none, the handler waits on the condition variable alone and makes no soc
+//   calls.
+// - Edge-triggered descriptors (all but listening sockets, as with EPOLLET on
+//   Linux) report POLLIN or POLLOUT once. The bit then stays out of the set
+//   until Rearm. poll() cannot mask POLLHUP, POLLERR or POLLNVAL, so once one
+//   is reported the descriptor leaves the set until Update changes it.
+//   Otherwise the handler thread, which runs above the Dart threads, would
+//   spin on a level that nobody consumes.
+// - Each port has at most one timer deadline, as in TimeoutQueue. A due timer
+//   is reported once and removed.
+class CtrPollSet {
+ public:
+  // The longest a message, re-arm or timer waits behind a poll() slice.
+  static constexpr int kPollSliceMillis = 10;
+
+  struct Message {
+    intptr_t id;
+    int64_t dart_port;
+    int64_t data;
+  };
+  struct Ready {
+    intptr_t fd;
+    int revents;
+  };
+  // Monotonic milliseconds, the clock of timer deadlines.
+  typedef int64_t (*Clock)();
+
+  explicit CtrPollSet(Clock clock);
+  ~CtrPollSet();
+
+  // Any thread. Queues a message for the next Wait and wakes it.
+  void Send(intptr_t id, int64_t dart_port, int64_t data);
+  // Any thread. Returns POLLIN and/or POLLOUT of an edge-triggered descriptor
+  // to the set after the socket consumed the reported readiness.
+  void Rearm(intptr_t fd, int events);
+
+  // Handler thread only. Sets the POLLIN/POLLOUT interest of |fd|; zero
+  // removes it. A changed interest starts again with nothing suppressed, as
+  // re-adding a descriptor to epoll reports its current state.
+  void Update(intptr_t fd, int events, bool edge_triggered);
+  // Handler thread only. Sets the deadline of |dart_port|'s timer; a negative
+  // deadline removes it.
+  void SetTimer(int64_t dart_port, int64_t deadline);
+  // Handler thread only. Blocks until a descriptor is ready, a message arrives
+  // or a timer is due, then publishes the results below. Returns false, with
+  // errno set, if poll() fails.
+  bool Wait();
+
+  // Results of the last Wait, valid until the next one.
+  intptr_t ready_count() const { return ready_count_; }
+  const Ready& ready(intptr_t i) const { return ready_[i]; }
+  intptr_t message_count() const { return delivered_count_; }
+  const Message& message(intptr_t i) const { return delivered_[i]; }
+  intptr_t timer_count() const { return due_count_; }
+  int64_t timer(intptr_t i) const { return due_[i]; }
+
+ private:
+  struct Entry {
+    intptr_t fd;
+    int events;
+    int suppressed;
+    bool edge_triggered;
+    bool closed;
+  };
+  struct Timer {
+    int64_t dart_port;
+    int64_t deadline;
+  };
+
+  void Lock();
+  void Unlock();
+  void Signal();
+  void Sleep(int timeout);
+  Entry* Find(intptr_t fd);
+  void Add(intptr_t fd, int events);
+  void Rebuild();
+  int Timeout();
+  void Collect(intptr_t polled);
+  void TakeMessages();
+
+  Clock clock_;
+
+  // Guarded by lock_: entries are shared with Rearm, the queue with Send.
+#if defined(__3DS__)
+  LightLock lock_;
+  CondVar changed_;
+#else
+  std::mutex lock_;
+  std::condition_variable changed_;
+#endif
+  Entry* entries_ = nullptr;
+  intptr_t entry_count_ = 0;
+  intptr_t entry_capacity_ = 0;
+  bool dirty_ = true;
+  Message* queued_ = nullptr;
+  intptr_t queued_count_ = 0;
+  intptr_t queued_capacity_ = 0;
+
+  // Handler thread only.
+  struct pollfd* fds_ = nullptr;
+  intptr_t fd_count_ = 0;
+  intptr_t fd_capacity_ = 0;
+  Timer* timers_ = nullptr;
+  intptr_t timer_count_ = 0;
+  intptr_t timer_capacity_ = 0;
+  Ready* ready_ = nullptr;
+  intptr_t ready_count_ = 0;
+  intptr_t ready_capacity_ = 0;
+  Message* delivered_ = nullptr;
+  intptr_t delivered_count_ = 0;
+  intptr_t delivered_capacity_ = 0;
+  int64_t* due_ = nullptr;
+  intptr_t due_count_ = 0;
+  intptr_t due_capacity_ = 0;
+
+  CtrPollSet(const CtrPollSet&) = delete;
+  CtrPollSet& operator=(const CtrPollSet&) = delete;
+};
+
+}  // namespace bin
+}  // namespace dart
+
+#endif  // RUNTIME_BIN_EVENTHANDLER_CTR_POLL_H_
