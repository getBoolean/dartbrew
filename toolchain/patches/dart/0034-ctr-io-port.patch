+++ b/runtime/bin/utils_ctr.cc
@@ -0,0 +1,130 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_CTR)
+
+#include <3ds.h>
+#include <errno.h>  // NOLINT
+#include <netdb.h>  // NOLINT
+
+#include "bin/unsupported_ctr.h"
+#include "bin/utils.h"
+#include "platform/assert.h"
+#include "platform/utils.h"
+
+namespace dart {
+namespace bin {
+
+static const char* const kAreaNames[] = {
+    "Crypto",
+    "Directory",
+    "File",
+    "FileSystemWatcher",
+    "InternetAddress",
+    "Link",
+    "NetworkInterface",
+    "Pipe",
+    "Platform",
+    "Process",
+    "RawSynchronousSocket",
+    "Signal",
+    "Socket",
+    "Stdin",
+    "Stdout",
+};
+static_assert(ARRAY_SIZE(kAreaNames) == static_cast<int>(CtrArea::kCount));
+
+void SetCtrUnsupported(CtrArea area) {
+  errno = kCtrUnsupportedErrno + static_cast<int>(area);
+}
+
+const char* CtrUnsupportedArea(int code) {
+  const int area = code - kCtrUnsupportedErrno;
+  if (area < 0 || area >= static_cast<int>(CtrArea::kCount)) {
+    return nullptr;
+  }
+  return kAreaNames[area];
+}
+
+OSError::OSError() : sub_system_(kSystem), code_(0), message_(nullptr) {
+  Reload();
+}
+
+void OSError::Reload() {
+  SetCodeAndMessage(kSystem, errno);
+}
+
+void OSError::SetCodeAndMessage(SubSystem sub_system, int code) {
+  set_sub_system(sub_system);
+  set_code(code);
+  if (sub_system == kSystem) {
+    const int kBufferSize = 1024;
+    char error_buf[kBufferSize];
+    const char* area = CtrUnsupportedArea(code);
+    if (area != nullptr) {
+      set_code(ENOSYS);
+      Utils::SNPrint(error_buf, kBufferSize,
+                     "%s is not supported on CTR (dart:io)", area);
+      SetMessage(error_buf);
+    } else {
+      SetMessage(Utils::StrError(code, error_buf, kBufferSize));
+    }
+  } else if (sub_system == kGetAddressInfo) {
+    SetMessage(gai_strerror(code));
+  } else {
+    UNREACHABLE();
+  }
+}
