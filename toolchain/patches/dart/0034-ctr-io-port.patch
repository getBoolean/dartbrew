diff --git a/runtime/bin/ctr/BUILD.gn b/runtime/bin/ctr/BUILD.gn
new file mode 100644
index 00000000..f64fa3f4
--- /dev/null
+++ b/runtime/bin/ctr/BUILD.gn
@@ -0,0 +1,83 @@
+# Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+# for details. All rights reserved. Use of this source code is governed by a
+# BSD-style license that can be found in the LICENSE file.
+
+# The dart:io implementation for CTR embedders. Loading ../BUILD.gn or
+# //third_party/zlib/BUILD.gn in the CTR toolchain fails, because Chromium
+# zlib selects NEON for every ARM CPU ("Unsupported ARM OS"); ARMv6K has none.
+# So these targets restate the dart_io and libdart_builtin source sets.
+
+import("../builtin_impl_sources.gni")
+import("../io_impl_sources.gni")
+
+assert(is_ctr, "These targets build dart:io for the CTR toolchain only")
+
+_configs = [
+  "//runtime:dart_arch_config",
+  "//runtime:dart_config",
+  "//runtime:dart_maybe_product_config",
+  "//runtime:dart_os_config",
+]
+
+config("zlib_config") {
+  include_dirs = [ "//third_party/zlib" ]
+}
+
+# The portable zlib sources, without Chromium's SIMD and CPU detection.
+source_set("zlib") {
+  sources = [
+    "//third_party/zlib/adler32.c",
+    "//third_party/zlib/compress.c",
+    "//third_party/zlib/cpu_features.c",
+    "//third_party/zlib/crc32.c",
+    "//third_party/zlib/deflate.c",
+    "//third_party/zlib/infback.c",
+    "//third_party/zlib/inffast.c",
+    "//third_party/zlib/inflate.c",
+    "//third_party/zlib/inftrees.c",
+    "//third_party/zlib/trees.c",
+    "//third_party/zlib/uncompr.c",
+    "//third_party/zlib/zutil.c",
+  ]
+  defines = [
+    "CPU_NO_SIMD",
+    "ZLIB_IMPLEMENTATION",
+  ]
+  configs -= [ "//build/config/compiler:chromium_code" ]
+  configs += [ "//build/config/compiler:no_chromium_code" ]
+  public_configs = [ ":zlib_config" ]
+}
+
+source_set("libdart_builtin") {
+  configs += _configs
+  include_dirs = [ "//runtime" ]
+  sources = rebase_path(builtin_impl_sources, ".", "..")
+}
+
+source_set("dart_io_sources") {
+  configs += _configs
+  public_configs = [ "//runtime:dart_public_config" ]
+  deps = [
+    ":libdart_builtin",
+    ":zlib",
+  ]
+  # CTR uses secure_socket_unsupported.cc until BoringSSL is ported.
+  defines = [ "DART_IO_SECURE_SOCKET_DISABLED" ]
+  include_dirs = [
+    "//runtime",
+    "//third_party",
+  ]
+  sources = rebase_path(io_impl_sources, ".", "..") + [
+              "../../include/bin/dart_io_api.h",
+              "../builtin.cc",
+              "../builtin_natives.cc",
+              "../dart_io_api_impl.cc",
+              "../io_natives.cc",
+              "../io_natives.h",
+            ]
+}
+
+static_library("dart_io") {
+  complete_static_lib = true
+  deps = [ ":dart_io_sources" ]
+}
