+
+// The console cannot start or signal processes. Process results carry an
+// OSError naming the Process area, and signal watching names Signal.
+
+namespace dart {
+namespace bin {
+
+int Process::global_exit_code_ = 0;
+Mutex* Process::global_exit_code_mutex_ = nullptr;
+Process::ExitHook Process::exit_hook_ = nullptr;
+
+static const char* const kProcessUnsupported =
+    "Process is not supported on CTR (dart:io)";
+
+int Process::Start(Namespace* namespc,
+                   const char* path,
+                   const char* arguments[],
+                   intptr_t arguments_length,
+                   const char* working_directory,
+                   char* environment[],
+                   intptr_t environment_length,
+                   ProcessStartMode mode,
+                   intptr_t* in,
+                   intptr_t* out,
+                   intptr_t* err,
+                   intptr_t* id,
+                   intptr_t* exit_event,
+                   char** os_error_message) {
+  *os_error_message = DartUtils::ScopedCopyCString(kProcessUnsupported);
+  return ENOSYS;
+}
+
+bool Process::Wait(intptr_t pid,
+                   intptr_t in,
+                   intptr_t out,
+                   intptr_t err,
+                   intptr_t exit_event,
+                   ProcessResult* result) {
+  SetCtrUnsupported(CtrArea::kProcess);
+  return false;
+}
+
+int Process::Exec(Namespace* namespc,
+                  const char* path,
+                  const char* arguments[],
+                  intptr_t arguments_length,
+                  const char* working_directory,
+                  char* errmsg,
+                  intptr_t errmsg_len) {
+  Utils::SNPrint(errmsg, errmsg_len, "%s", kProcessUnsupported);
+  errno = ENOSYS;
+  return -1;
+}
+
+bool Process::Kill(intptr_t id, int signal) {
+  SetCtrUnsupported(CtrArea::kProcess);
+  return false;
+}
+
+void Process::TerminateExitCodeHandler() {}
+
+intptr_t Process::CurrentProcessId() {
+  u32 pid = 0;
+  svcGetProcessId(&pid, CUR_PROCESS_HANDLE);
+  return pid;
+}
+
+int64_t Process::CurrentRSS() {
+  SetCtrUnsupported(CtrArea::kProcess);
+  return -1;
+}
+
+int64_t Process::MaxRSS() {
+  SetCtrUnsupported(CtrArea::kProcess);
+  return -1;
+}
+
+SignalInfo::~SignalInfo() {}
+
+intptr_t Process::SetSignalHandler(intptr_t signal) {
+  SetCtrUnsupported(CtrArea::kSignal);
+  return -1;
+}
+
+void Process::ClearSignalHandler(intptr_t signal, Dart_Port port) {}
+
+void Process::ClearSignalHandlerByFd(intptr_t fd, Dart_Port port) {}
+
+void Process::Init() {
+  ASSERT(Process::global_exit_code_mutex_ == nullptr);
+  Process::global_exit_code_mutex_ = new Mutex();
+}
+
+void Process::Cleanup() {
+  ASSERT(Process::global_exit_code_mutex_ != nullptr);
+  delete Process::global_exit_code_mutex_;
+  Process::global_exit_code_mutex_ = nullptr;
+}
+
