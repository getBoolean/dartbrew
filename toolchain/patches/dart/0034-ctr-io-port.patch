+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_BIN_UNSUPPORTED_CTR_H_
+#define RUNTIME_BIN_UNSUPPORTED_CTR_H_
+
+#include "platform/globals.h"
+
+#if !defined(DART_HOST_OS_CTR)
+#error "unsupported_ctr.h is only for CTR builds."
+#endif
+
+namespace dart {
+namespace bin {
+
+// dart:io areas that are not yet ported to CTR.
+enum class CtrArea {
+  kCrypto,
+  kDirectory,
+  kFile,
+  kFileSystemWatcher,
+  kInternetAddress,
+  kLink,
+  kNetworkInterface,
+  kPipe,
+  kPlatform,
+  kProcess,
+  kRawSynchronousSocket,
+  kSignal,
+  kSocket,
+  kStdin,
+  kStdout,
+  kCount,
+};
+
+// An unported operation stores kCtrUnsupportedErrno + area in errno. errno is
+// per thread, so the area reaches the OSError built on the failing thread
+// (including IOService threads) and cannot go stale. OSError reports it as
+// ENOSYS with the message "<Area> is not supported on CTR (dart:io)".
+constexpr int kCtrUnsupportedErrno = 0x43540000;
+
+// Sets errno for an unported operation in |area|.
+void SetCtrUnsupported(CtrArea area);
+
+// Returns the area name for an errno value set by SetCtrUnsupported, or
+// nullptr for any other value.
+const char* CtrUnsupportedArea(int code);
+
+}  // namespace bin
+}  // namespace dart
+
+#endif  // RUNTIME_BIN_UNSUPPORTED_CTR_H_
