+int64_t TimerUtils::GetCurrentMonotonicMicros() {
+  const int64_t ticks = svcGetSystemTick();
+  return (ticks / SYSCLOCK_ARM11) * kMicrosecondsPerSecond +
+         ((ticks % SYSCLOCK_ARM11) * kMicrosecondsPerSecond) / SYSCLOCK_ARM11;
+}
