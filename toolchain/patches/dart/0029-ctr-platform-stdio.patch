+#ifndef RUNTIME_BIN_STDIO_CTR_H_
+#define RUNTIME_BIN_STDIO_CTR_H_
+
+#include "include/bin/dart_io_api.h"
+#include "platform/globals.h"
+
+#if !defined(DART_HOST_OS_CTR)
+#error "stdio_ctr.h is only for CTR builds."
