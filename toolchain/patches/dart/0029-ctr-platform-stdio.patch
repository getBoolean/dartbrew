+
+namespace dart {
+namespace bin {
+
+// The embedder's standard streams (SetCtrStdio). Without them, the standard
+// descriptors are newlib's (libctru's console).
+void SetCtrStdioImplementation(const CtrStdio& stdio);
+
+// Reads stdin: the number of bytes read, 0 at the end of input, or -1 with
+// errno set.
+intptr_t CtrStdinRead(uint8_t* buffer, intptr_t length);
+
+// Writes all of |buffer| to stdout (fd 1) or stderr (fd 2); false with errno
+// set on failure.
+bool CtrStdioWrite(intptr_t fd, const uint8_t* buffer, intptr_t length);
+
+}  // namespace bin
+}  // namespace dart
