+#if defined(__3DS__)
+// CTR (Nintendo 3DS) embedders own the standard streams and the end of the
+// run.
+struct CtrStdio {
+  // Takes the |length| bytes the program wrote to stdout (fd 1) or stderr
+  // (fd 2). Returns false on failure.
+  bool (*write)(intptr_t fd, const uint8_t* buffer, intptr_t length);
+  // Blocks until stdin has bytes. Returns the number read (at most |length|),
+  // 0 at the end of input, or -1 with errno set.
+  intptr_t (*read)(uint8_t* buffer, intptr_t length);
+};
+
+// Routes dart:io's stdin, stdout and stderr to |stdio|. Call before the first
+// isolate starts; without it they use newlib's standard descriptors.
+void SetCtrStdio(const CtrStdio& stdio);
+
+// Called by dart:io's exit(code) on the isolate's thread. When it returns,
+// the isolate unwinds to the embedder with an API error, without running Dart
+// catch or finally blocks; the embedder then ends the run with the code.
+void SetExitHook(void (*hook)(int64_t exit_code));
