Restore page permissions on release and honor CTR region protection granularity.

diff --git a/runtime/vm/virtual_memory_ctr.cc b/runtime/vm/virtual_memory_ctr.cc
old mode 100755
new mode 100644
index cf60a1e8..dd68a1b6
--- a/runtime/vm/virtual_memory_ctr.cc
+++ b/runtime/vm/virtual_memory_ctr.cc
@@ -80,35 +80,54 @@ void VirtualMemory::Protect(void* address, intptr_t size, Protection mode) {
       permissions = MEMPERM_READWRITE | MEMPERM_EXECUTE;
       break;
   }
-  Result result;
   if ((permissions & MEMPERM_EXECUTE) != 0) {
     // VM callback trampolines copy bytes then call WriteProtectCode directly;
     // they do not pass through CPU::FlushICache at Code::FinalizeCode.
     CtrFlushICache(page, length);
-    // This SVC rejects the pseudo handle. A denied duplicate or permission
-    // change must terminate publication, never let the caller execute anyway.
-    Handle process = 0;
-    result = svcDuplicateHandle(&process, CUR_PROCESS_HANDLE);
-    if (R_FAILED(result)) {
-      FATAL("CTR duplicate process handle failed: 0x%08x",
-            static_cast<unsigned int>(result));
+  }
+  // A libc allocation can span several kernel regions, even when their
+  // reported state and permissions are identical. Query each region and avoid
+  // redundant protection calls: CTR may reject an already-RW restoration.
+  uword cursor = page;
+  while (cursor < end) {
+    MemInfo memory = {};
+    PageInfo info = {};
+    const u32 query = static_cast<u32>(cursor);
+    const Result queried = svcQueryMemory(&memory, &info, query);
+    const uint64_t region_end = static_cast<uint64_t>(memory.base_addr) + memory.size;
+    if (R_FAILED(queried) || memory.state == 0 || memory.size == 0 ||
+        memory.base_addr > query || region_end <= query ||
+        !Utils::IsAligned(memory.base_addr, PageSize()) ||
+        !Utils::IsAligned(memory.size, PageSize())) {
+      FATAL("CTR memory query failed: address=%p result=0x%08x state=%u",
+            reinterpret_cast<void*>(cursor), static_cast<unsigned int>(queried),
+            static_cast<unsigned int>(memory.state));
     }
-    result = svcControlProcessMemory(process, static_cast<u32>(page), 0,
-                                     length, MEMOP_PROT, permissions);
-    const Result closed = svcCloseHandle(process);
-    if (R_FAILED(closed)) {
-      FATAL("CTR close process handle failed: 0x%08x",
-            static_cast<unsigned int>(closed));
+    const uword remaining = end - cursor;
+    const uint64_t available = region_end - query;
+    const u32 segment = static_cast<u32>(available < remaining ? available : remaining);
+    if (memory.perm != permissions) {
+      // A real handle is required, including for restoration of code pages.
+      Handle process = 0;
+      Result result = svcDuplicateHandle(&process, CUR_PROCESS_HANDLE);
+      if (R_FAILED(result)) {
+        FATAL("CTR duplicate process handle failed: 0x%08x",
+              static_cast<unsigned int>(result));
+      }
+      result = svcControlProcessMemory(process, query, 0, segment,
+                                       MEMOP_PROT, permissions);
+      const Result closed = svcCloseHandle(process);
+      if (R_FAILED(closed)) {
+        FATAL("CTR close process handle failed: 0x%08x",
+              static_cast<unsigned int>(closed));
+      }
+      if (R_FAILED(result)) {
+        FATAL("CTR memory protection failed: address=%p size=0x%x mode=%u result=0x%08x",
+              reinterpret_cast<void*>(cursor), static_cast<unsigned int>(segment),
+              static_cast<unsigned int>(permissions), static_cast<unsigned int>(result));
+      }
     }
-  } else {
-    u32 out = 0;
-    result = svcControlMemory(&out, static_cast<u32>(page), 0, length,
-                              MEMOP_PROT, static_cast<MemPerm>(permissions));
-  }
-  if (R_FAILED(result)) {
-    FATAL("CTR memory protection failed: address=%p size=0x%x mode=%u result=0x%08x",
-          reinterpret_cast<void*>(page), static_cast<unsigned int>(length),
-          static_cast<unsigned int>(permissions), static_cast<unsigned int>(result));
+    cursor += segment;
   }
 }
 
