+
+#include "vm/globals.h"
+#if defined(DART_HOST_OS_CTR)
+
+#include "vm/native_symbol.h"
+
+// These section symbols participate in 3DSX relocation. __start__ is absolute.
+extern "C" char _start[];
+extern "C" char __bss_end__[];
+
+namespace dart {
+
+static const char kImageName[] = "ctr-static-image";
+
+// Same opaque format as native_symbol_posix.cc. The embedder retains immutable
+// table storage until Cleanup; the resolver owns only list nodes.
+class NativeSymbols {
+ public:
+  NativeSymbols(void* buffer, size_t size, NativeSymbols* next)
+      : buffer_(static_cast<const uint8_t*>(buffer)),
+        size_(size),
+        next_(next) {}
+
+  NativeSymbols* next() const { return next_; }
+
+  bool IsValid() const {
+    if (buffer_ == nullptr || size_ < sizeof(uint32_t)) return false;
+    const uint32_t count = ReadWord(0);
+    if (count > (size_ - sizeof(uint32_t)) / kEntrySize) return false;
+    const size_t names = sizeof(uint32_t) + count * kEntrySize;
+    uint32_t previous = 0;
+    for (uint32_t i = 0; i < count; i++) {
+      const size_t entry = sizeof(uint32_t) + i * kEntrySize;
+      const uint32_t offset = ReadWord(entry);
+      const uint32_t name = ReadWord(entry + 2 * sizeof(uint32_t));
+      if (offset < previous || name >= size_ - names ||
+          memchr(buffer_ + names + name, '\0', size_ - names - name) ==
+              nullptr) {
+        return false;
+      }
+      previous = offset;
+    }
+    return true;
+  }
+
+  const char* Lookup(uword offset, uword* start) const {
+    const uint32_t count = ReadWord(0);
+    intptr_t lo = 0;
+    intptr_t hi = static_cast<intptr_t>(count) - 1;
+    while (lo <= hi) {
+      const intptr_t mid = lo + (hi - lo) / 2;
+      const size_t entry = sizeof(uint32_t) + mid * kEntrySize;
+      const uint32_t symbol_offset = ReadWord(entry);
+      const uint32_t length = ReadWord(entry + sizeof(uint32_t));
+      if (offset < symbol_offset) {
+        hi = mid - 1;
+      } else if (offset - symbol_offset >= length) {
+        lo = mid + 1;
+      } else {
+        const size_t names = sizeof(uint32_t) + count * kEntrySize;
+        const char* name = reinterpret_cast<const char*>(
+            buffer_ + names + ReadWord(entry + 2 * sizeof(uint32_t)));
+        // Follow Windows' caller-owned name contract, including after Cleanup.
+        const size_t length = strlen(name) + 1;
+        char* copy = static_cast<char*>(::malloc(length));
+        if (copy != nullptr) memcpy(copy, name, length);
+        if (copy != nullptr && start != nullptr) *start = symbol_offset;
+        return copy;
+      }
+    }
+    return nullptr;
+  }
+
+ private:
+  uint32_t ReadWord(size_t offset) const {
+    uint32_t result;
+    memcpy(&result, buffer_ + offset, sizeof(result));
+    return result;
+  }
+
+  static constexpr size_t kEntrySize = 3 * sizeof(uint32_t);
+  const uint8_t* const buffer_;
+  const size_t size_;
+  NativeSymbols* const next_;
+};
+
+static NativeSymbols* symbols_ = nullptr;
+
+void NativeSymbolResolver::Init() {
+  ASSERT(symbols_ == nullptr);
+}
+
+void NativeSymbolResolver::Cleanup() {
+  while (symbols_ != nullptr) {
+    NativeSymbols* next = symbols_->next();
+    delete symbols_;
+    symbols_ = next;
+  }
+}
+
+bool NativeSymbolResolver::LookupSharedObject(uword pc,
+                                              uword* dso_base,
+                                              const char** dso_name) {
+  const uword base = reinterpret_cast<uword>(_start);
+  const uword end = reinterpret_cast<uword>(__bss_end__);
+  if (pc < base || pc >= end) return false;
+  if (dso_base != nullptr) *dso_base = base;
+  if (dso_name != nullptr) *dso_name = kImageName;
+  return true;
+}
+
+const char* NativeSymbolResolver::LookupSymbolName(uword pc, uword* start) {
+  uword base;
+  if (!LookupSharedObject(pc, &base)) return nullptr;
+  for (NativeSymbols* symbols = symbols_; symbols != nullptr;
+       symbols = symbols->next()) {
+    uword offset;
+    const char* name = symbols->Lookup(pc - base, &offset);
+    if (name != nullptr) {
+      if (start != nullptr) *start = base + offset;
+      return name;
+    }
+  }
+  return nullptr;
+}
+
+void NativeSymbolResolver::FreeSymbolName(const char* name) {
+  free(const_cast<char*>(name));
+}
+
+void NativeSymbolResolver::AddSymbols(const char* dso_name,
+                                      void* buffer,
+                                      size_t size) {
+  // One statically linked image; there is no OS dynamic ELF loader.
+  if (dso_name == nullptr || strcmp(dso_name, kImageName) != 0) return;
+  NativeSymbols* symbols = new NativeSymbols(buffer, size, symbols_);
+  if (!symbols->IsValid()) {
+    delete symbols;
+    return;
+  }
+  symbols_ = symbols;
+}
+
+}  // namespace dart
+
+#endif  // defined(DART_HOST_OS_CTR)
