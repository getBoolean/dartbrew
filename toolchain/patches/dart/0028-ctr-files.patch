+constexpr char kSdmc[] = "sdmc:";
+constexpr size_t kSdmcLength = sizeof(kSdmc) - 1;
+
+// The length of a device prefix "<device>:" (a colon before any separator),
+// or 0 when |path| has none.
+size_t DevicePrefix(const char* path) {
+  for (size_t i = 0; path[i] != '\0' && path[i] != '/'; i++) {
+    if (path[i] == ':') return i + 1;
+  }
+  return 0;
+}
+
+// |path| without an "sdmc:" prefix, which names the same file as "/".
+const char* WithoutSdmc(const char* path) {
+  return strncmp(path, kSdmc, kSdmcLength) == 0 ? path + kSdmcLength : path;
+}
+
+// Appends |length| bytes of |text| to |out| at |*used|; false if it does not
+// fit with a terminating NUL.
+bool Append(char* out, size_t size, size_t* used, const char* text,
+            size_t length) {
+  if (*used + length >= size) return false;
+  memcpy(out + *used, text, length);
+  *used += length;
+  out[*used] = '\0';
+  return true;
+}
+
+// Adds the segments of |path| (after its root) to |out|, which holds the root
+// in its first |root| bytes.
+bool AddSegments(const char* path, char* out, size_t size, size_t root,
+                 size_t* used) {
+  while (*path != '\0') {
+    while (*path == '/') path++;
+    const char* end = strchr(path, '/');
+    const size_t length = end == nullptr ? strlen(path) : end - path;
+    if (length == 0 || (length == 1 && path[0] == '.')) {
+      // Empty or "." segment.
+    } else if (length == 2 && path[0] == '.' && path[1] == '.') {
+      while (*used > root && out[*used - 1] != '/') (*used)--;
+      if (*used > root) (*used)--;
+      out[*used] = '\0';
+    } else {
+      if (*used > root && !Append(out, size, used, "/", 1)) return false;
+      if (!Append(out, size, used, path, length)) return false;
+    }
+    path += length;
+  }
+  return true;
+}
+
+// Writes the root of the absolute Dart path |path| ("/" or "<device>:/") and
+// returns the rest of the path, or nullptr if |path| is relative or the root
+// does not fit.
+const char* Root(const char* path, char* out, size_t size, size_t* used) {
+  const char* rest = WithoutSdmc(path);
+  if (rest != path) {
+    // "sdmc:..." is on the SD card, whose root is "/".
+    return Append(out, size, used, "/", 1) ? rest : nullptr;
+  }
+  const size_t device = DevicePrefix(path);
+  if (device == 0 && path[0] != '/') return nullptr;
+  if (!Append(out, size, used, path, device) ||
+      !Append(out, size, used, "/", 1)) {
+    return nullptr;
+  }
+  return path + device;
