+size_t CtrNativePath(const char* path, char* out, size_t size) {
+  const size_t length = strlen(path);
+  const bool sdmc = path[0] == '/';
+  const size_t result = (sdmc ? kSdmcLength : 0) + length;
+  if (result < size) {
