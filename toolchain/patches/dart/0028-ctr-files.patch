+
+#ifndef RUNTIME_BIN_PATH_CTR_H_
+#define RUNTIME_BIN_PATH_CTR_H_
+
+#include <stddef.h>
+
+// The CTR path model. Dart code sees POSIX-style paths whose root "/" is the
+// SD card. newlib (libctru's devoptab) names files by device: "sdmc:/x" on the
+// SD card, "romfs:/x" in the application's romfs. A Dart path may also carry
+// a device prefix ("<device>:"), which makes it absolute; "sdmc:/x" is the
+// same file as "/x" and is reported as "/x".
+//
+// These functions only rewrite strings, so host tests can compile them
+// (DART_CTR_PATH_HOST_TEST).
+
+namespace dart {
+namespace bin {
+
+// Whether the path has a leading slash or a device prefix.
+bool CtrIsAbsolutePath(const char* path);
+
+// Writes to |out| the path newlib opens for the Dart path |path|: "/x"
+// becomes "sdmc:/x"; relative paths and device paths are unchanged. Returns
+// the length of the result; it was written only if smaller than |size|.
+size_t CtrNativePath(const char* path, char* out, size_t size);
+
+// Rewrites a native or Dart path in place to its Dart form: an "sdmc:" prefix
+// is removed ("sdmc:" alone is "/"), and trailing separators after the root
+// are dropped.
+void CtrDartPath(char* path);
+
+// Writes to |out| the absolute Dart path of |path|, resolved against the
+// absolute Dart path |cwd| when relative. "." and empty segments are removed
+// and ".." removes the previous segment, never the root; CTR file systems
+// have no links, so this lexical result names the same entry. Returns false
+// if the result does not fit in |size| bytes.
+bool CtrAbsolutePath(const char* cwd, const char* path, char* out,
+                     size_t size);
+
+}  // namespace bin
+}  // namespace dart
+
+#endif  // RUNTIME_BIN_PATH_CTR_H_
