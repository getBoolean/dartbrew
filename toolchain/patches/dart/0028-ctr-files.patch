+      return;
+    }
+    memmove(path, rest, strlen(rest) + 1);
+  }
+  const size_t device = DevicePrefix(path);
+  const size_t root = device + (path[device] == '/' ? 1 : 0);
+  size_t length = strlen(path);
+  while (length > root && path[length - 1] == '/') path[--length] = '\0';
+}
+
+bool CtrAbsolutePath(const char* cwd, const char* path, char* out,
+                     size_t size) {
+  if (size == 0) return false;
+  out[0] = '\0';
+  size_t used = 0;
+  if (!CtrIsAbsolutePath(path)) {
+    const char* cwd_rest = Root(cwd, out, size, &used);
+    if (cwd_rest == nullptr) return false;
+    const size_t root = used;
+    if (!AddSegments(cwd_rest, out, size, root, &used)) return false;
+    return AddSegments(path, out, size, root, &used);
+  }
+  const char* rest = Root(path, out, size, &used);
+  return rest != nullptr && AddSegments(rest, out, size, used, &used);
+}
