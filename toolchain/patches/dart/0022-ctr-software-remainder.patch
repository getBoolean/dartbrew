Compute IEEE remainder and modulo with software arithmetic.

diff --git a/runtime/vm/ctr_double_helpers.cc b/runtime/vm/ctr_double_helpers.cc
index fdc678d2..fd95a0eb 100755
--- a/runtime/vm/ctr_double_helpers.cc
+++ b/runtime/vm/ctr_double_helpers.cc
@@ -161,3 +161,77 @@ extern "C" bool CtrDoublePowSpecial(double base, double exponent, double* result
   __builtin_memcpy(result, &output, sizeof(output));
   return true;
 }
+
+static double RemainderBits(uint64_t bits) {
+  double value;
+  __builtin_memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+extern "C" double CtrDoubleRemainder(double left, double right) {
+  uint64_t x, y;
+  __builtin_memcpy(&x, &left, sizeof(x));
+  __builtin_memcpy(&y, &right, sizeof(y));
+  const uint64_t sign = x & UINT64_C(0x8000000000000000);
+  x &= UINT64_C(0x7fffffffffffffff);
+  y &= UINT64_C(0x7fffffffffffffff);
+  const uint64_t infinity = UINT64_C(0x7ff0000000000000);
+  const uint64_t hidden = UINT64_C(0x0010000000000000);
+  const uint64_t fraction = hidden - 1;
+  if (x >= infinity || y > infinity || y == 0) {
+    return RemainderBits(UINT64_C(0x7ff8000000000000));
+  }
+  if (x < y) return left;  // Includes signed zero and finite x / infinite y.
+  if (x == y) return RemainderBits(sign);
+
+  uint64_t mx = x & fraction;
+  uint64_t my = y & fraction;
+  int ex = static_cast<int>(x >> 52);
+  int ey = static_cast<int>(y >> 52);
+  if (ex != 0) {
+    mx |= hidden;
+    ex -= 1023;
+  } else {
+    ex = -1022;
+    while (mx < hidden) { mx <<= 1; --ex; }
+  }
+  if (ey != 0) {
+    my |= hidden;
+    ey -= 1023;
+  } else {
+    ey = -1022;
+    while (my < hidden) { my <<= 1; --ey; }
+  }
+  // Binary long division: after subtraction mx < my, so each following
+  // shift needs at most one subtraction and the accumulator fits 54 bits.
+  while (ex > ey) {
+    if (mx >= my) mx -= my;
+    if (mx == 0) return RemainderBits(sign);
+    mx <<= 1;
+    --ex;
+  }
+  if (mx >= my) mx -= my;
+  if (mx == 0) return RemainderBits(sign);
+  while (mx < hidden) { mx <<= 1; --ex; }
+  // An fmod remainder of binary64 operands is exactly representable.
+  // For subnormal results the discarded low bits are therefore all zero.
+  const uint64_t magnitude = ex >= -1022
+      ? (static_cast<uint64_t>(ex + 1023) << 52) | (mx & fraction)
+      : mx >> (-1022 - ex);
+  return RemainderBits(sign | magnitude);
+}
+
+extern "C" double CtrDoubleModulo(double left, double right) {
+  const double remainder = CtrDoubleRemainder(left, right);
+  uint64_t bits;
+  __builtin_memcpy(&bits, &remainder, sizeof(bits));
+  const uint64_t sign = UINT64_C(0x8000000000000000);
+  const uint64_t magnitude = bits & ~sign;
+  if (magnitude == 0) return RemainderBits(0);
+  if ((bits & sign) != 0 && magnitude < UINT64_C(0x7ff0000000000000)) {
+    uint64_t divisor;
+    __builtin_memcpy(&divisor, &right, sizeof(divisor));
+    return CtrDoubleAdd(remainder, RemainderBits(divisor & ~sign));
+  }
+  return remainder;
+}
