diff --git a/runtime/vm/ctr_double_helpers.cc b/runtime/vm/ctr_double_helpers.cc
index 54421c77..fdc678d2 100755
--- a/runtime/vm/ctr_double_helpers.cc
+++ b/runtime/vm/ctr_double_helpers.cc
@@ -125,3 +125,39 @@ extern "C" double CtrDoubleSqrt(double value) {
   __builtin_memcpy(&value, &result, sizeof(value));
   return value;
 }
+
+extern "C" bool CtrDoublePowSpecial(double base, double exponent, double* result) {
+  uint64_t b, e;
+  __builtin_memcpy(&b, &base, sizeof(b));
+  __builtin_memcpy(&e, &exponent, sizeof(e));
+  const uint64_t magnitude = UINT64_C(0x7fffffffffffffff);
+  const uint64_t infinity = UINT64_C(0x7ff0000000000000);
+  const uint64_t one = UINT64_C(0x3ff0000000000000);
+  uint64_t output;
+  if ((e & magnitude) == 0 || b == one) {
+    output = one;
+  } else if ((b & magnitude) > infinity || (e & magnitude) > infinity) {
+    output = UINT64_C(0x7ff8000000000000);
+  } else if (e == one) {
+    output = b;
+  } else if (e == UINT64_C(0x4000000000000000)) {
+    *result = CtrDoubleMul(base, base);
+    return true;
+  } else if (e == UINT64_C(0x4008000000000000)) {
+    *result = CtrDoubleMul(CtrDoubleMul(base, base), base);
+    return true;
+  } else if (e == UINT64_C(0x3fe0000000000000)) {
+    if ((b & magnitude) == 0) {
+      output = 0;  // Both signed zero bases produce positive zero.
+    } else if ((b & magnitude) == infinity) {
+      output = infinity;  // Unlike sqrt, pow(-infinity, 0.5) is positive infinity.
+    } else {
+      *result = CtrDoubleSqrt(base);
+      return true;
+    }
+  } else {
+    return false;  // General powers remain with the existing libm provider.
+  }
+  __builtin_memcpy(result, &output, sizeof(output));
+  return true;
+}
