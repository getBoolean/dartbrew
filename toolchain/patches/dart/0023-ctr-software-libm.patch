Route supported math intrinsics through the hard-float bridge.

diff --git a/runtime/vm/compiler/backend/evaluator.cc b/runtime/vm/compiler/backend/evaluator.cc
index eded59f6..0a6a1aec 100644
--- a/runtime/vm/compiler/backend/evaluator.cc
+++ b/runtime/vm/compiler/backend/evaluator.cc
@@ -217,11 +217,23 @@ double Evaluator::EvaluateUnaryDoubleOp(const double value,
       case Token::kSQUARE:
         return value * value;
       case Token::kTRUNCATE:
+#if defined(DART_HOST_OS_CTR)
+        return CtrLibmTrunc(value);
+#else
         return trunc(value);
+#endif
       case Token::kFLOOR:
+#if defined(DART_HOST_OS_CTR)
+        return CtrLibmFloor(value);
+#else
         return floor(value);
+#endif
       case Token::kCEILING:
+#if defined(DART_HOST_OS_CTR)
+        return CtrLibmCeil(value);
+#else
         return ceil(value);
+#endif
       default:
         UNREACHABLE();
     }
