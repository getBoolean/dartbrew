diff --git a/runtime/vm/os_thread_ctr.cc b/runtime/vm/os_thread_ctr.cc
new file mode 100644
index 00000000..5eaa4b30
--- /dev/null
+++ b/runtime/vm/os_thread_ctr.cc
@@ -0,0 +1,244 @@
+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_CTR)
+#include <errno.h>
+#include "vm/os_thread.h"
+
+extern "C" {
+extern u32 __ctru_heap;
+extern u32 __stacksize__;
+extern char __tdata_align[];
+}
+namespace dart {
+struct CtrNativeThread {
+  Thread native = nullptr;
+  Handle handle = 0;
+  LightEvent ready;
+  OSThread::ThreadStartFunction function;
+  uword parameter;
+  char* name;
+  bool join_requested = false;  // Only the owning thread accesses this.
+  bool detached = false;        // Protected by reap_lock.
+  bool entry_done = false;      // Protected by reap_lock.
+  CtrNativeThread* next = nullptr;
+};
+static thread_local CtrNativeThread* current_native = nullptr;
+static thread_local uword stack_low = 0;
+static thread_local uword stack_high = 0;
+static LightLock reap_lock;
+static LightEvent reap_event;
+static CtrNativeThread* reap_head = nullptr;
+static Thread reaper = nullptr;
+static Handle reaper_handle = 0;
+static bool stopping = false;
+// Counts started/starting VM workers until their native allocation is freed.
+static intptr_t outstanding = 0;  // Protected by reap_lock.
+static u32 main_id = 0;
+
+static void EstablishFloatingPointMode() {
+  // Match libctru's VFP11 transport policy: nearest rounding, FZ and DN,
+  // exceptions disabled. Dart arithmetic needs software assistance; clearing
+  // FZ alone would trap on subnormals and does not implement IEEE semantics.
+  const u32 before = __builtin_arm_get_fpscr();
+  const u32 policy = (1u << 25) | (1u << 24);
+  __builtin_arm_set_fpscr(policy);
+  const u32 active = __builtin_arm_get_fpscr();
+  if (active != policy) {
+    FATAL("CTR FPSCR policy failed: 0x%08x", static_cast<unsigned int>(active));
+  }
+  fprintf(stderr,
+          "CTR thread %u FPSCR before=%08x active=%08x; software arithmetic "
+          "required\n",
+          static_cast<unsigned int>(platform::GetCurrentThreadId()),
+          static_cast<unsigned int>(before), static_cast<unsigned int>(active));
+}
+static void JoinAndFree(Thread native, Handle handle) {
+  // libctru threadJoin returns early when its software 'finished' flag is
+  // set, BEFORE svcExitThread. Wait on the captured kernel handle instead.
+  Result result = svcWaitSynchronization(handle, U64_MAX);
+  if (R_FAILED(result)) {
+    FATAL("CTR kernel join failed: 0x%08x", static_cast<unsigned int>(result));
+  }
+  threadFree(native);
+}
+static void ReclaimNativeThread(CtrNativeThread* item) {
+  JoinAndFree(item->native, item->handle);
+  free(item->name);
+  delete item;
+  LightLock_Lock(&reap_lock);
+  RELEASE_ASSERT(outstanding > 0);
+  --outstanding;
+  LightLock_Unlock(&reap_lock);
+  LightEvent_Signal(&reap_event);
+}
+static void Reap(void*) {
+  EstablishFloatingPointMode();
+  for (;;) {
+    LightEvent_Wait(&reap_event);
+    for (;;) {
+      LightLock_Lock(&reap_lock);
+      CtrNativeThread* item = reap_head;
+      if (item != nullptr) reap_head = item->next;
+      bool done = stopping && item == nullptr && outstanding == 0;
+      LightLock_Unlock(&reap_lock);
+      if (done) return;
+      if (item == nullptr) break;
+      ReclaimNativeThread(item);
+    }
+  }
+}
+void InitializeCtrThreads() {
+  RELEASE_ASSERT(reaper == nullptr && outstanding == 0 && reap_head == nullptr);
+  RELEASE_ASSERT(reinterpret_cast<uword>(__tdata_align) <= 8);
+  main_id = platform::GetCurrentThreadId();
+  RELEASE_ASSERT(threadGetCurrent() == nullptr);
+  // initSystem reserves the main stack at the beginning of __ctru_heap.
+  // svcQueryMemory alone would report the entire heap as usable stack.
+  stack_low = __ctru_heap;
+  stack_high = (stack_low + __stacksize__ + 7) & ~static_cast<uword>(7);
+  RELEASE_ASSERT(stack_low < OSThread::GetCurrentStackPointer() &&
+                 OSThread::GetCurrentStackPointer() < stack_high);
+  EstablishFloatingPointMode();
+  LightLock_Init(&reap_lock);
+  LightEvent_Init(&reap_event, RESET_ONESHOT);
+  stopping = false;
+  reaper = threadCreate(Reap, nullptr, 32 * KB, 0x30, 0, false);
+  if (reaper == nullptr) FATAL("CTR native thread reaper could not start");
+  reaper_handle = threadGetHandle(reaper);
+}
+void CleanupCtrThreads() {
+  RELEASE_ASSERT(platform::GetCurrentThreadId() == main_id);
+  LightLock_Lock(&reap_lock);
+  stopping = true;
+  LightLock_Unlock(&reap_lock);
+  LightEvent_Signal(&reap_event);
+  JoinAndFree(reaper, reaper_handle);
+  reaper = nullptr;
+  OSThread::CleanupCurrentThread();
+  stack_low = stack_high = 0;
+  main_id = 0;
+}
+void OSThread::CleanupCurrentThread() {
+  OSThread* thread = static_cast<OSThread*>(GetCurrentTLS());
+  if (thread != nullptr && !thread->is_os_thread()) {
+    FATAL("CTR thread exited without exiting its Dart isolate");
+  }
+  SetCurrent(nullptr);
+  delete thread;
+}
+static void ThreadStart(void* parameter) {
+  CtrNativeThread* data = static_cast<CtrNativeThread*>(parameter);
+  LightEvent_Wait(&data->ready);
+  current_native = data;
+  RELEASE_ASSERT(reinterpret_cast<uword>(__tdata_align) <= 8);
+  // Pinned libctru sets TP = stacktop - 8, independent of the TLS size.
+  stack_high = reinterpret_cast<uword>(__builtin_thread_pointer()) + 8;
+  stack_low = stack_high - OSThread::GetMaxStackSize();
+  EstablishFloatingPointMode();
+  OSThread* thread = OSThread::CreateOSThread();
+  if (thread != nullptr) {
+    OSThread::SetCurrent(thread);
+    thread->SetName(data->name);
+    data->function(data->parameter);
+    OSThread::CleanupCurrentThread();
+  }
+  // Queue only after the callback and TLS cleanup finish. A long-running
+  // detached callback must not block reclamation of other completed threads.
+  LightLock_Lock(&reap_lock);
+  if (!data->join_requested) data->detached = true;
+  data->entry_done = true;
+  const bool reap = data->detached;
+  if (reap) {
+    data->next = reap_head;
+    reap_head = data;
+  }
+  LightLock_Unlock(&reap_lock);
+  if (reap) LightEvent_Signal(&reap_event);
+  current_native = nullptr;
+  stack_low = stack_high = 0;
+  // Do not touch data after publication: the reaper owns it, but cannot free the
+  // stack or TLS until the kernel confirms that this entry has returned.
+}
+int OSThread::TryStart(const char* name,
+                       ThreadStartFunction function,
+                       uword parameter) {
+  LightLock_Lock(&reap_lock);
+  const bool can_start = reaper != nullptr && !stopping;
+  // Reserve ownership before releasing the lock: shutdown may start while
+  // threadCreate is still allocating the stack or launching its entry.
+  if (can_start) ++outstanding;
+  LightLock_Unlock(&reap_lock);
+  RELEASE_ASSERT(can_start);
+  auto* data = new CtrNativeThread();
+  data->function = function;
+  data->parameter = parameter;
+  data->name = Utils::StrDup(name);
+  LightEvent_Init(&data->ready, RESET_ONESHOT);
+  data->native =
+      threadCreate(ThreadStart, data, GetMaxStackSize(), 0x30, 0, false);
+  if (data->native == nullptr) {
+    free(data->name);
+    delete data;
+    LightLock_Lock(&reap_lock);
+    --outstanding;
+    LightLock_Unlock(&reap_lock);
+    LightEvent_Signal(&reap_event);
+    return EAGAIN;
+  }
+  data->handle = threadGetHandle(data->native);
+  LightEvent_Signal(&data->ready);
+  return 0;
+}
+const ThreadJoinId OSThread::kInvalidThreadJoinId = nullptr;
+intptr_t OSThread::GetMaxStackSize() {
+  return 512 * KB;
+}
+#ifdef SUPPORT_TIMELINE
+ThreadId OSThread::GetCurrentThreadTraceId() {
+  return GetCurrentThreadId();
+}
+#endif
+char* OSThread::GetCurrentThreadName() {
+  return Utils::StrDup(current_native == nullptr ? "CTR main"
+                                                 : current_native->name);
+}
+ThreadJoinId OSThread::GetCurrentThreadJoinId(OSThread* thread) {
+  RELEASE_ASSERT(thread != nullptr && thread->id() == GetCurrentThreadId());
+  RELEASE_ASSERT(current_native != nullptr && !current_native->join_requested);
+  current_native->join_requested = true;
+  return current_native;
+}
+void OSThread::Join(ThreadJoinId id) {
+  RELEASE_ASSERT(id != nullptr && id != current_native && !id->detached);
+  ReclaimNativeThread(id);
+}
+void OSThread::Detach(ThreadJoinId id) {
+  RELEASE_ASSERT(id != nullptr);
+  LightLock_Lock(&reap_lock);
+  RELEASE_ASSERT(!id->detached);
+  id->detached = true;
+  const bool reap = id->entry_done;
+  if (reap) {
+    id->next = reap_head;
+    reap_head = id;
+  }
+  LightLock_Unlock(&reap_lock);
+  if (reap) LightEvent_Signal(&reap_event);
+}
+intptr_t OSThread::ThreadIdToIntPtr(ThreadId id) {
+  return id;
+}
+ThreadId OSThread::ThreadIdFromIntPtr(intptr_t id) {
+  return id;
+}
+bool OSThread::GetCurrentStackBounds(uword* lower, uword* upper) {
+  if (stack_low == 0 || stack_high == 0) return false;
+  const uword sp = GetCurrentStackPointer();
+  if (!(stack_low < sp && sp < stack_high)) return false;
+  *lower = stack_low;
+  *upper = stack_high;
+  return true;
+}
+}  // namespace dart
+#endif
