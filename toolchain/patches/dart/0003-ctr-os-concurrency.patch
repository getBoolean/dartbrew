+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_CTR)
+#include <3ds.h>
+#include <errno.h>
+#include <time.h>
+#include <climits>
+#include <cstddef>
+#include "platform/utils.h"
+#include "vm/image_snapshot.h"
+#include "vm/os.h"
+#include "vm/os_thread.h"
+#include "vm/timeline.h"
+#include "vm/zone.h"
+
+namespace dart {
+intptr_t OS::ProcessId() {
+  u32 pid;
+  Result result = svcGetProcessId(&pid, CUR_PROCESS_HANDLE);
+  if (R_FAILED(result)) {
+    FATAL("CTR process identity failed: 0x%08x",
+          static_cast<unsigned int>(result));
+  }
+  return pid;
+}
+// The console stores no timezone. Its configured wall clock is interpreted as
+// UTC, matching libctru/newlib; no geographic offset can be inferred.
+const char* OS::GetTimeZoneName(int64_t seconds) {
+  return "UTC";
+}
+int OS::GetTimeZoneOffsetInSeconds(int64_t seconds) {
+  return 0;
+}
+int64_t OS::GetCurrentTimeMillis() {
+  return GetCurrentTimeMicros() / kMicrosecondsPerMillisecond;
+}
+int64_t OS::GetCurrentTimeMicros() {
+  timespec now;
+  if (clock_gettime(CLOCK_REALTIME, &now) != 0) {
+    FATAL("CTR wall clock failed: errno=%d", errno);
+  }
+  return static_cast<int64_t>(now.tv_sec) * kMicrosecondsPerSecond +
+         now.tv_nsec / kNanosecondsPerMicrosecond;
+}
+int64_t OS::GetCurrentMonotonicTicks() {
+  const int64_t ticks = svcGetSystemTick();
+  if (ticks < 0) FATAL("CTR monotonic clock returned invalid ticks");
+  return ticks;
+}
+int64_t OS::GetCurrentMonotonicFrequency() {
+  return SYSCLOCK_ARM11;
+}
+int64_t OS::GetCurrentMonotonicMicros() {
+  const int64_t ticks = GetCurrentMonotonicTicks();
+  // Split before multiplication: uptime must not overflow a tick*1e6 product.
+  return (ticks / SYSCLOCK_ARM11) * kMicrosecondsPerSecond +
+         ((ticks % SYSCLOCK_ARM11) * kMicrosecondsPerSecond) / SYSCLOCK_ARM11;
+}
+int64_t OS::GetCurrentThreadCPUMicros() {
+  return -1;
+}  // No CPU usage clock.
+int64_t OS::GetCurrentMonotonicMicrosForTimeline() {
+#ifdef SUPPORT_TIMELINE
+  if (Timeline::recorder_discards_clock_values()) return -1;
+  return GetCurrentMonotonicMicros();
+#else
+  return -1;
+#endif
+}
+bool OS::GetEntropy(uint8_t* buffer, intptr_t length) {
+  RELEASE_ASSERT(length >= 0);
+  if (length == 0) return true;
+  static Mutex mutex;
+  mutex.Lock();
+  Result result = psInit();
+  if (R_SUCCEEDED(result)) {
+    result = PS_GenerateRandomBytes(buffer, length);
+    psExit();
+  }
+  mutex.Unlock();
+  if (R_FAILED(result)) {
+    memset(buffer, 0, length);
+    PrintErr("CTR entropy service failed: 0x%08x\n",
+             static_cast<unsigned int>(result));
+    return false;
+  }
+  return true;
+}
+intptr_t OS::ActivationFrameAlignment() {
+  return 8;
+}
+uintptr_t OS::CurrentRSS() {
+  s64 used;
+  Result result = svcGetProcessInfo(&used, CUR_PROCESS_HANDLE, 0x1);
+  return R_SUCCEEDED(result) && used >= 0 ? used : 0;
+}
+bool OS::SafeReadMemory(void* address,
+                        uint8_t* buffer,
+                        size_t size,
+                        const char** error) {
+  uword cursor = reinterpret_cast<uword>(address);
+  if (size > ~static_cast<uword>(0) - cursor) {
+    *error = "CTR address range overflow";
+    return false;
+  }
+  const uword end = cursor + size;
+  while (cursor < end) {
+    MemInfo memory = {};
+    PageInfo page;
+    Result result = svcQueryMemory(&memory, &page, cursor);
+    const uword region_end = static_cast<uword>(memory.base_addr) + memory.size;
+    if (R_FAILED(result) || !(memory.perm & MEMPERM_READ) ||
+        memory.base_addr > cursor || region_end <= cursor) {
+      *error = "CTR address range is not readable";
+      return false;
+    }
+    cursor = region_end < end ? region_end : end;
+  }
+  // Callers must keep the allocation alive while reading it.
+  memcpy(buffer, address, size);
+  return true;
+}
+void OS::Sleep(int64_t millis) {
+  RELEASE_ASSERT(millis >= 0 && millis <= kMaxInt64 / 1000);
+  SleepMicros(millis * 1000);
+}
+void OS::SleepMicros(int64_t micros) {
+  RELEASE_ASSERT(micros >= 0 && micros <= kMaxInt64 / 1000);
+  svcSleepThread(micros * 1000);
+}
+void OS::DebugBreak() {
+  __builtin_trap();
+}
+// These hooks control external Linux perf recording, not GC coordination.
+void OS::NotifyBeforeGC() {}
+void OS::NotifyAfterGC() {}
+DART_NOINLINE uintptr_t OS::GetProgramCounter() {
+  return reinterpret_cast<uintptr_t>(
+      __builtin_extract_return_addr(__builtin_return_address(0)));
+}
+
+void OS::Print(const char* format, ...) {
+  va_list args;
+  va_start(args, format);
+  VFPrint(stdout, format, args);
+  va_end(args);
+}
+
+void OS::VFPrint(FILE* stream, const char* format, va_list args) {
+  vfprintf(stream, format, args);
+  fflush(stream);
+}
+
+char* OS::SCreate(Zone* zone, const char* format, ...) {
+  va_list args;
+  va_start(args, format);
+  char* buffer = VSCreate(zone, format, args);
+  va_end(args);
+  return buffer;
+}
+
+char* OS::VSCreate(Zone* zone, const char* format, va_list args) {
+  // Measure.
+  va_list measure_args;
+  va_copy(measure_args, args);
+  intptr_t len = Utils::VSNPrint(nullptr, 0, format, measure_args);
+  va_end(measure_args);
+
+  char* buffer;
+  if (zone != nullptr) {
+    buffer = zone->Alloc<char>(len + 1);
+  } else {
+    buffer = reinterpret_cast<char*>(malloc(len + 1));
+  }
+  ASSERT(buffer != nullptr);
+
+  // Print.
+  va_list print_args;
+  va_copy(print_args, args);
+  Utils::VSNPrint(buffer, len + 1, format, print_args);
+  va_end(print_args);
+  return buffer;
+}
+
+bool OS::ParseInitialInt64(const char* str, int64_t* value, char** end) {
+  ASSERT(str != nullptr && strlen(str) > 0 && value != nullptr &&
+         end != nullptr);
+  int32_t base = 10;
+  int i = 0;
+  if (str[0] == '-') {
+    i = 1;
+  } else if (str[0] == '+') {
+    i = 1;
+  }
+  if ((str[i] == '0') && (str[i + 1] == 'x' || str[i + 1] == 'X') &&
+      (str[i + 2] != '\0')) {
+    base = 16;
+  }
+  errno = 0;
+  if (base == 16) {
+    // Unsigned 64-bit hexadecimal integer literals are allowed but
+    // immediately interpreted as signed 64-bit integers.
+    *value = static_cast<int64_t>(strtoull(str, end, base));
+  } else {
+    *value = strtoll(str, end, base);
+  }
+  return (errno == 0) && (*end != str);
+}
+
