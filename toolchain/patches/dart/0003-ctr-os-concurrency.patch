diff --git a/runtime/vm/os_thread_ctr_test.cc b/runtime/vm/os_thread_ctr_test.cc
new file mode 100644
index 00000000..8755d499
--- /dev/null
+++ b/runtime/vm/os_thread_ctr_test.cc
@@ -0,0 +1,85 @@
+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_CTR)
+#include "vm/os.h"
+#include "vm/os_thread.h"
+#include "vm/unit_test.h"
+namespace dart {
+static thread_local uint32_t generation = 0;
+struct CtrThreadTestState {
+  Monitor monitor;
+  bool ready = false;
+  bool finish = false;
+  bool valid = false;
+  ThreadId id = 0;
+  ThreadJoinId join = nullptr;
+  uword tls = 0;
+};
+static void CtrTestWorker(uword parameter) {
+  auto* state = reinterpret_cast<CtrThreadTestState*>(parameter);
+  uword lower, upper;
+  const uword sp = OSThread::GetCurrentStackPointer();
+  const bool initial_tls = generation == 0;
+  generation = 123;
+  state->monitor.Enter();
+  state->id = OSThread::GetCurrentThreadId();
+  state->join = OSThread::GetCurrentThreadJoinId(OSThread::Current());
+  state->tls = reinterpret_cast<uword>(&generation);
+  state->valid =
+      initial_tls && generation == 123 &&
+      OSThread::GetCurrentStackBounds(&lower, &upper) && lower < sp &&
+      sp < upper &&
+      upper - lower == static_cast<uword>(OSThread::GetMaxStackSize()) &&
+      (__builtin_arm_get_fpscr() & 0x07ff9f00u) == ((1u << 25) | (1u << 24));
+  state->ready = true;
+  state->monitor.NotifyAll();
+  while (!state->finish)
+    state->monitor.Wait(Monitor::kNoTimeout);
+  state->monitor.Exit();
+}
+VM_UNIT_TEST_CASE(CtrThreadIdentityTlsBoundsAndTeardown) {
+  const ThreadId main_id = OSThread::GetCurrentThreadId();
+  EXPECT(threadGetCurrent() == nullptr);
+  generation = 456;
+  uword lower, upper;
+  EXPECT(OSThread::GetCurrentStackBounds(&lower, &upper));
+  EXPECT(lower < OSThread::GetCurrentStackPointer());
+  EXPECT(OSThread::GetCurrentStackPointer() < upper);
+  EXPECT_EQ((1u << 25) | (1u << 24), __builtin_arm_get_fpscr() & 0x07ff9f00u);
+  for (int round = 0; round < 16; ++round) {
+    CtrThreadTestState state[2];
+    for (int i = 0; i < 2; ++i) {
+      OSThread::Start("CTR contract worker", CtrTestWorker,
+                      reinterpret_cast<uword>(&state[i]));
+      state[i].monitor.Enter();
+      while (!state[i].ready)
+        state[i].monitor.Wait(Monitor::kNoTimeout);
+      EXPECT(state[i].valid);
+      EXPECT_NE(main_id, state[i].id);
+      EXPECT_NE(reinterpret_cast<uword>(&generation), state[i].tls);
+      state[i].monitor.Exit();
+    }
+    EXPECT_NE(state[0].id, state[1].id);
+    EXPECT_NE(state[0].tls, state[1].tls);
+    for (int i = 0; i < 2; ++i) {
+      if (round & 1) OSThread::Detach(state[i].join);
+      state[i].monitor.Enter();
+      state[i].finish = true;
+      state[i].monitor.NotifyAll();
+      state[i].monitor.Exit();
+      if (!(round & 1)) OSThread::Join(state[i].join);
+      const int64_t deadline = OS::GetCurrentMonotonicMicros() + 2000000;
+      while (OSThread::IsThreadInList(state[i].id) &&
+             OS::GetCurrentMonotonicMicros() < deadline)
+        OS::SleepMicros(1000);
+      EXPECT(!OSThread::IsThreadInList(state[i].id));
+      // Acquire/release ensures the worker has stopped accessing this fixture.
+      state[i].monitor.Enter();
+      state[i].monitor.Exit();
+    }
+    EXPECT_EQ(456u, generation);
+  }
+}
+}  // namespace dart
+#endif
