@@ -0,0 +1,57 @@
+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_CTR)
+#include "platform/synchronization.h"
+
+namespace dart {
+Mutex::Mutex() {
+  LightLock_Init(&mutex_);
+}
+Mutex::~Mutex() {}
+void Mutex::Lock() {
+  DEBUG_ASSERT(!DisallowMutexLockingScope::is_active());
+  LightLock_Lock(&mutex_);
+  owner_.Acquire();
+}
+bool Mutex::TryLock() {
+  DEBUG_ASSERT(!DisallowMutexLockingScope::is_active());
+  if (LightLock_TryLock(&mutex_) != 0) return false;
+  owner_.Acquire();
+  return true;
+}
+void Mutex::Unlock() {
+  owner_.Release();
+  LightLock_Unlock(&mutex_);
+}
+ConditionVariable::ConditionVariable() {
+  CondVar_Init(&cv_);
+}
+ConditionVariable::~ConditionVariable() {}
+ConditionVariable::WaitResult ConditionVariable::Wait(Mutex* mutex,
+                                                      int64_t millis) {
+  RELEASE_ASSERT(millis >= 0 && millis <= kMaxInt64 / 1000);
+  return WaitMicros(mutex, millis * 1000);
+}
+ConditionVariable::WaitResult ConditionVariable::WaitMicros(Mutex* mutex,
+                                                            int64_t micros) {
+  RELEASE_ASSERT(micros >= 0 && micros <= kMaxInt64 / 1000);
+  mutex->owner_.Release();
+  WaitResult result = kNotified;
+  if (micros == kNoTimeout) {
+    CondVar_Wait(&cv_, &mutex->mutex_);
+  } else if (CondVar_WaitTimeout(&cv_, &mutex->mutex_, micros * 1000)) {
+    result = kTimedOut;
+  }
+  // Both libctru paths reacquire the light lock before returning.
+  mutex->owner_.Acquire();
+  return result;
+}
+void ConditionVariable::Notify() {
+  CondVar_Signal(&cv_);
+}
+void ConditionVariable::NotifyAll() {
+  CondVar_Broadcast(&cv_);
+}
+}  // namespace dart
+#endif
