new file mode 100644
index 00000000..05377ae1
--- /dev/null
+++ b/third_party/double-conversion/src/ieee-operations.h
@@ -0,0 +1,79 @@
+// Copyright (c) 2026, the Dart project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#ifndef DOUBLE_CONVERSION_IEEE_OPERATIONS_H_
+#define DOUBLE_CONVERSION_IEEE_OPERATIONS_H_
+
+#include "utils.h"
+#include <cmath>
+
+namespace double_conversion {
+
+#if defined(__3DS__)
+// The VM arithmetic bridges use hard-float arguments; GCC's providers use
+// integer registers even in a hard-float binary. Keep that distinction explicit.
+extern "C" double CtrDoubleMul(double, double);
+extern "C" double CtrDoubleDiv(double, double);
+extern "C" double CtrDoubleSub(double, double);
+extern "C" {
+double __aeabi_ul2d(uint64_t) __attribute__((pcs("aapcs")));
+double __aeabi_l2d(int64_t) __attribute__((pcs("aapcs")));
+double __aeabi_i2d(int) __attribute__((pcs("aapcs")));
+int __aeabi_d2iz(double) __attribute__((pcs("aapcs")));
+float __aeabi_d2f(double) __attribute__((pcs("aapcs")));
+double __aeabi_f2d(float) __attribute__((pcs("aapcs")));
+}
+inline double IeeeDouble(uint64_t v) { return __aeabi_ul2d(v); }
+inline double IeeeDouble(int64_t v) { return __aeabi_l2d(v); }
+inline double IeeeDouble(int v) { return __aeabi_i2d(v); }
+inline double IeeeDouble(float v) { return __aeabi_f2d(v); }
+inline float IeeeFloat(double v) { return __aeabi_d2f(v); }
+inline double IeeeMul(double a, double b) { return CtrDoubleMul(a, b); }
+inline double IeeeDiv(double a, double b) { return CtrDoubleDiv(a, b); }
+inline double IeeeSub(double a, double b) { return CtrDoubleSub(a, b); }
+inline double IeeeNegate(double v) {
+  return BitCast<double>(BitCast<uint64_t>(v) ^ (uint64_t(1) << 63));
+}
+inline bool IeeeEqual(double a, double b) {
+  uint64_t x = BitCast<uint64_t>(a), y = BitCast<uint64_t>(b);
+  const uint64_t magnitude = ~(uint64_t(1) << 63);
+  const uint64_t infinity = uint64_t(0x7ff00000) << 32;
+  if ((x & magnitude) > infinity || (y & magnitude) > infinity) return false;
+  return x == y || ((x | y) & magnitude) == 0;
+}
+inline bool IeeeLess(double a, double b) {
+  uint64_t x = BitCast<uint64_t>(a), y = BitCast<uint64_t>(b);
+  const uint64_t sign = uint64_t(1) << 63;
+  const uint64_t magnitude = ~sign;
+  const uint64_t infinity = uint64_t(0x7ff00000) << 32;
+  if ((x & magnitude) > infinity || (y & magnitude) > infinity ||
+      ((x | y) & magnitude) == 0) return false;
+  if ((x ^ y) & sign) return (x & sign) != 0;
+  return (x & sign) ? x > y : x < y;
+}
+#else
+inline double IeeeDouble(uint64_t v) { return static_cast<double>(v); }
+inline double IeeeDouble(int64_t v) { return static_cast<double>(v); }
+inline double IeeeDouble(int v) { return static_cast<double>(v); }
+inline double IeeeDouble(float v) { return static_cast<double>(v); }
+inline float IeeeFloat(double v) { return static_cast<float>(v); }
+inline double IeeeMul(double a, double b) { return a * b; }
+inline double IeeeDiv(double a, double b) { return a / b; }
+inline double IeeeSub(double a, double b) { return a - b; }
+inline double IeeeNegate(double v) { return -v; }
+inline bool IeeeEqual(double a, double b) { return a == b; }
+inline bool IeeeLess(double a, double b) { return a < b; }
+#endif
+inline bool IeeeLessEqual(double a, double b) {
+  return IeeeLess(a, b) || IeeeEqual(a, b);
+}
+// Only decimal exponent estimates call this: finite values in [-400, 400].
+inline int DecimalExponentCeil(double v) {
+#if defined(__3DS__)
+  int truncated = __aeabi_d2iz(v);
+  return truncated + (IeeeLess(IeeeDouble(truncated), v) ? 1 : 0);
+#else
+  return static_cast<int>(ceil(v));
+#endif
+}
+}  // namespace double_conversion
+#endif  // DOUBLE_CONVERSION_IEEE_OPERATIONS_H_
