diff --git a/runtime/vm/cpu_cache_ctr.cc b/runtime/vm/cpu_cache_ctr.cc
new file mode 100644
index 00000000..5b63ff94
--- /dev/null
+++ b/runtime/vm/cpu_cache_ctr.cc
@@ -0,0 +1,55 @@
+// Copyright (c) 2026, the Dart project authors. Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+#include "vm/globals.h"
+#if defined(DART_HOST_OS_CTR)
+#include "vm/cpu_cache_ctr.h"
+#include "platform/assert.h"
+#include <3ds.h>
+
+// The custom backdoor's callback runs privileged, on the calling core. The
+// callback returns zero in r0 only after completing cache maintenance. Keep the
+// SVC wrapper's stack 8-byte aligned and preserve the caller's return address.
+extern "C" int32_t DartCtrFlushEntireCache();
+#if defined(__arm__)
+asm(".pushsection .text\n"
+    ".arm\n"
+    ".balign 4\n"
+    ".global DartCtrFlushEntireCache\n"
+    ".type DartCtrFlushEntireCache, %function\n"
+    "DartCtrFlushEntireCache:\n"
+    "push {r4, lr}\n"
+    "adr r0, .Ldart_ctr_cache_kernel\n"
+    "svc 0x80\n"
+    "pop {r4, pc}\n"
+    ".size DartCtrFlushEntireCache, .-DartCtrFlushEntireCache\n"
+    ".Ldart_ctr_cache_kernel:\n"
+    "mrs r3, cpsr\n"
+    "cpsid aif\n"
+    "mov r0, #0\n"
+    "mcr p15, 0, r0, c7, c10, 0\n"  // clean D-cache
+    "mcr p15, 0, r0, c7, c10, 4\n"  // drain write buffer
+    "mcr p15, 0, r0, c7, c5, 0\n"   // invalidate I-cache/branch targets
+    "mcr p15, 0, r0, c7, c5, 4\n"   // prefetch flush
+    "msr cpsr_c, r3\n"
+    "bx lr\n"
+    ".popsection\n");
+#endif
+
+namespace dart {
+void CtrFlushICache(uword start, uword size) {
+  if (size == 0) return;
+  s64 version = 0;
+  const Result detected = svcGetSystemInfo(&version, 0x10000, 0);
+  if (R_FAILED(detected) || version == 0) {
+    FATAL("CTR instruction cache maintenance needs Luma custom SVC 0x80: 0x%08x",
+          static_cast<unsigned int>(detected));
+  }
+  const Result result = DartCtrFlushEntireCache();
+  if (R_FAILED(result)) {
+    FATAL("CTR instruction cache publication failed: address=%p result=0x%08x",
+          reinterpret_cast<void*>(start), static_cast<unsigned int>(result));
+  }
+}
+}  // namespace dart
+#endif  // defined(DART_HOST_OS_CTR)
