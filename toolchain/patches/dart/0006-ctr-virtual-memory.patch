diff --git a/runtime/vm/virtual_memory_ctr.cc b/runtime/vm/virtual_memory_ctr.cc
new file mode 100755
index 00000000..cf60a1e8
--- /dev/null
+++ b/runtime/vm/virtual_memory_ctr.cc
@@ -0,0 +1,122 @@
+// Copyright (c) 2026, the Dart project authors. Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/globals.h"
+#if defined(DART_HOST_OS_CTR)
+#include "vm/virtual_memory.h"
+#include "vm/cpu_cache_ctr.h"
+
+#include <3ds.h>
+#include <malloc.h>
+#include <string.h>
+
+namespace dart {
+
+DECLARE_FLAG(bool, write_protect_code);
+uword VirtualMemory::page_size_ = 0;
+
+intptr_t VirtualMemory::CalculatePageSize() { return 0x1000; }
+
+void VirtualMemory::Init() { page_size_ = CalculatePageSize(); }
+
+void VirtualMemory::Cleanup() { page_size_ = 0; }
+
+VirtualMemory* VirtualMemory::AllocateAligned(intptr_t size,
+                                             intptr_t alignment,
+                                             bool is_executable,
+                                             const char* name) {
+  ASSERT(Utils::IsAligned(size, PageSize()));
+  ASSERT(Utils::IsPowerOfTwo(alignment));
+  ASSERT(Utils::IsAligned(alignment, PageSize()));
+  if (size <= 0 || size > kIntptrMax - (alignment - PageSize())) {
+    return nullptr;
+  }
+  // Keep libc's allocation intact: its heap owns the mappings. In particular,
+  // never MEMOP_FREE an aligned interior or a truncated tail of this block.
+  const intptr_t allocated_size = size + alignment - PageSize();
+  void* allocation = memalign(PageSize(), allocated_size);
+  if (allocation == nullptr) return nullptr;
+  const uword aligned = Utils::RoundUp(reinterpret_cast<uword>(allocation),
+                                       alignment);
+  void* address = reinterpret_cast<void*>(aligned);
+  memset(address, 0, size);
+  MemoryRegion region(address, size);
+  MemoryRegion reserved(allocation, allocated_size);
+  if (is_executable && ExecutesGeneratedCode() && !FLAG_write_protect_code) {
+    Protect(address, size, kReadWriteExecute);
+  }
+  return new VirtualMemory(region, reserved);
+}
+
+VirtualMemory::~VirtualMemory() {
+  if (vm_owns_region()) {
+    // Restore all owned pages, including a protected/truncated tail, before
+    // libc can touch or reuse this allocation. Images never enter this path.
+    Protect(reserved_.pointer(), reserved_.size(), kReadWrite);
+    free(reserved_.pointer());
+  }
+}
+
+bool VirtualMemory::FreeSubSegment(void* address, intptr_t size) {
+  // Truncate may shrink the visible region, but libc cannot release interiors.
+  // Returning false preserves the original reservation for the destructor.
+  return false;
+}
+
+void VirtualMemory::Protect(void* address, intptr_t size, Protection mode) {
+  if (size == 0) return;
+  const uword start = reinterpret_cast<uword>(address);
+  const uword page = Utils::RoundDown(start, PageSize());
+  const uword end = Utils::RoundUp(start + size, PageSize());
+  const u32 length = static_cast<u32>(end - page);
+  u32 permissions = 0;
+  switch (mode) {
+    case kNoAccess: break;
+    case kReadOnly: permissions = MEMPERM_READ; break;
+    case kReadWrite: permissions = MEMPERM_READWRITE; break;
+    case kReadExecute: permissions = MEMPERM_READ | MEMPERM_EXECUTE; break;
+    case kReadWriteExecute:
+      permissions = MEMPERM_READWRITE | MEMPERM_EXECUTE;
+      break;
+  }
+  Result result;
+  if ((permissions & MEMPERM_EXECUTE) != 0) {
+    // VM callback trampolines copy bytes then call WriteProtectCode directly;
+    // they do not pass through CPU::FlushICache at Code::FinalizeCode.
+    CtrFlushICache(page, length);
+    // This SVC rejects the pseudo handle. A denied duplicate or permission
+    // change must terminate publication, never let the caller execute anyway.
+    Handle process = 0;
+    result = svcDuplicateHandle(&process, CUR_PROCESS_HANDLE);
+    if (R_FAILED(result)) {
+      FATAL("CTR duplicate process handle failed: 0x%08x",
+            static_cast<unsigned int>(result));
+    }
+    result = svcControlProcessMemory(process, static_cast<u32>(page), 0,
+                                     length, MEMOP_PROT, permissions);
+    const Result closed = svcCloseHandle(process);
+    if (R_FAILED(closed)) {
+      FATAL("CTR close process handle failed: 0x%08x",
+            static_cast<unsigned int>(closed));
+    }
+  } else {
+    u32 out = 0;
+    result = svcControlMemory(&out, static_cast<u32>(page), 0, length,
+                              MEMOP_PROT, static_cast<MemPerm>(permissions));
+  }
+  if (R_FAILED(result)) {
+    FATAL("CTR memory protection failed: address=%p size=0x%x mode=%u result=0x%08x",
+          reinterpret_cast<void*>(page), static_cast<unsigned int>(length),
+          static_cast<unsigned int>(permissions), static_cast<unsigned int>(result));
+  }
+}
+
+void VirtualMemory::DontNeed(void* address, intptr_t size) {
+  // Optional reclamation hint (sweeper and snapshot readers). CTR libc offers
+  // no page-discard operation for live allocations; retain contents/ownership.
+  // This is not used for mandatory permission changes or code publication.
+}
+
+}  // namespace dart
+#endif  // defined(DART_HOST_OS_CTR)
