diff --git a/build/ctr/BUILD.gn b/build/ctr/BUILD.gn
new file mode 100644
index 00000000..92f57d9b
--- /dev/null
+++ b/build/ctr/BUILD.gn
@@ -0,0 +1,15 @@
+# Executed on Linux, targeting ARM/CTR, unlike gen_snapshot_host_targeting_host.
+group("precompiler") {
+  deps = [
+    "//runtime/bin:gen_snapshot($host_toolchain)",
+    "//build/toolchain/ctr:abi_probe",
+  ]
+}
+
+group("aot_runtime") {
+  deps = [ "//runtime:libdart_aotruntime" ]
+}
+
+group("jit_runtime") {
+  deps = [ "//runtime:libdart_jit" ]
+}
diff --git a/build/toolchain/ctr/BUILD.gn b/build/toolchain/ctr/BUILD.gn
new file mode 100644
index 00000000..9d1223fc
--- /dev/null
+++ b/build/toolchain/ctr/BUILD.gn
@@ -0,0 +1,34 @@
+# CTR uses the upstream GCC template and Linux host generators.
+import("//build/toolchain/gcc_toolchain.gni")
+import("ctr.gni")
+
+config("target_config") {
+  assert(ctr_compiler_prefix != "" && ctr_libctru != "" && ctr_specs_file != "",
+         "Supply the pinned repository CTR profile")
+  cflags = ctr_cflags
+  asmflags = ctr_cflags
+  include_dirs = [ "$ctr_libctru/include" ]
+  defines = [ "__3DS__" ]
+  ldflags = ctr_cflags + [ "-specs=$ctr_specs_file" ]
+  lib_dirs = [ "$ctr_libctru/lib" ]
+  libs = [ "ctru", "m" ]
+}
+
+gcc_toolchain("arm") {
+  cc = "${ctr_compiler_prefix}gcc"
+  cxx = "${ctr_compiler_prefix}g++"
+  asm = cc
+  ar = "${ctr_compiler_prefix}ar"
+  ld = cxx
+  readelf = "${ctr_compiler_prefix}readelf"
+  nm = "${ctr_compiler_prefix}nm"
+  toolchain_cpu = "arm"
+  toolchain_os = "ctr"
+  is_clang = false
+}
+
+# This source-set proves configuration without requiring an unported VM.
+source_set("abi_probe") {
+  sources = [ "probe.cc" ]
+}
+
